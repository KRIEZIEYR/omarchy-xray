}
DNS_SCHEMES = ("https", "tls", "tcp", "quic", "h2c")


def dns_custom_ok(addr):
    """Your own DNS server as Xray takes it: a bare IP or scheme://host[:port][/path]."""
    if not isinstance(addr, str) or not 0 < len(addr) <= 200 or _CTRL_RE.search(addr) or " " in addr:
        return False
    if is_ip(addr):
        return True
    u = urllib.parse.urlsplit(addr)
    try:
        u.port
        check_host(u.hostname)
    except ValueError:
        return False
    return u.scheme in DNS_SCHEMES and not u.query and not u.fragment and not u.username
