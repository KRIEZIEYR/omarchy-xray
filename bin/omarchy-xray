_SYS_DIRS = ("/usr/bin", "/usr/sbin", "/bin", "/sbin", "/usr/local/bin")
_SAFE_PATH = "/usr/local/sbin:/usr/local/bin:/usr/bin:/usr/sbin:/bin:/sbin"


def tool(name):
    """Absolute path of a system tool from fixed directories (never $PATH)."""
    for d in _SYS_DIRS:
        p = os.path.join(d, name)
        if os.path.isfile(p) and os.access(p, os.X_OK):
            return p
    return None


def find_xray():
    """xray core: fixed system locations first, then $PATH (a user-local core
    is fine for proxy mode; tun-install insists on a root-owned binary)."""
    for p in ("/usr/bin/xray", "/usr/local/bin/xray", "/opt/xray/xray"):
        if os.path.isfile(p) and os.access(p, os.X_OK):
            return p
    return shutil.which("xray") or "/usr/bin/xray"


XRAY = find_xray()
SELF = str(pathlib.Path(__file__).resolve())

