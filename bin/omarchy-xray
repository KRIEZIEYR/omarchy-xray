# --- plumbing ----------------------------------------------------------------

def die(msg, code=1):
    """Errors go to stdout as JSON (the widget reads stdout) and to stderr as
    a readable line for terminal use."""
    print(json.dumps({"ok": False, "error": msg}))
    print("omarchy-xray: " + msg, file=sys.stderr)
    sys.exit(code)


def out(obj):
    print(json.dumps(obj, ensure_ascii=False))


def redact_url(url):
    """Host-only redaction for logs/status — tokens live in path/query."""
    try:
        u = urllib.parse.urlsplit(url or "")
        if not u.hostname:
            return "***"
        return "%s://%s/***" % (u.scheme or "https", u.hostname)
    except Exception:
        return "***"


def _cfg_dir():
    CFG.mkdir(parents=True, exist_ok=True)
    try:
        os.chmod(CFG, 0o700)
    except OSError:
        pass
    return CFG


def runtime_dir():
    """Owner-only runtime directory ($XDG_RUNTIME_DIR/omarchy-xray)."""
    base = os.environ.get("XDG_RUNTIME_DIR") or "/run/user/%d" % os.getuid()
    d = pathlib.Path(base) / "omarchy-xray"
    try:
        d.mkdir(mode=0o700, parents=True, exist_ok=True)
        os.chmod(d, 0o700)
        if d.stat().st_uid != os.getuid():
            raise OSError("not ours")
        return d
    except OSError:
        return _cfg_dir()


def atomic_write(path, text, mode=0o600):
    """Atomic write (tmp + rename) with explicit mode. Secrets default 0600."""
    path = pathlib.Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=str(path.parent), prefix="." + path.name + ".")
    try:
        os.fchmod(fd, mode)
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(text)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def read_nofollow(path, cap):
    """Read a small file without following symlinks; None when absent."""
    try:
        fd = os.open(str(path), os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except FileNotFoundError:
        return None
    except OSError:
        raise ValueError("%s is not a regular file (refusing to follow link)" % path)
    with os.fdopen(fd, "rb") as f:
        data = f.read(cap + 1)
    if len(data) > cap:
        raise ValueError("%s exceeds %d bytes" % (path, cap))
    return data.decode("utf-8", "replace")


def load_json(path, default):
    try:
        text = read_nofollow(path, 4 * 1024 * 1024)
        if text is None:
            return default
        v = json.loads(text)
        return v if isinstance(v, type(default)) else default
    except Exception:
        return default


def asset_dir():
    """Directory holding geoip.dat + geosite.dat, if any."""
    cands = []
    env = os.environ.get("XRAY_LOCATION_ASSET")
    if env:
        cands.append(env)
    try:
        cands.append(os.path.dirname(os.path.realpath(XRAY)))
    except OSError:
        pass
    cands.append(str(GEO_DIR))           # `geo update` downloads; newer than the distro's
    cands.extend(ASSET_DIRS)
    for d in cands:
        if os.path.isfile(os.path.join(d, "geoip.dat")) and \
                os.path.isfile(os.path.join(d, "geosite.dat")):
            return d
    return None


def child_env(extra=None):
    """Closed environment for children: explicit allowlist, fixed PATH."""
    env = {"PATH": _SAFE_PATH, "LC_ALL": "C.UTF-8"}
    for k in ("HOME", "USER", "LOGNAME", "XDG_RUNTIME_DIR", "DBUS_SESSION_BUS_ADDRESS"):
        if os.environ.get(k):
            env[k] = os.environ[k]
    if os.getuid() != 0:
        env.setdefault("XDG_RUNTIME_DIR", "/run/user/%d" % os.getuid())
        env.setdefault("DBUS_SESSION_BUS_ADDRESS",
                       "unix:path=%s/bus" % env["XDG_RUNTIME_DIR"])
    a = asset_dir()
    if a:
        env["XRAY_LOCATION_ASSET"] = a
    if extra:
        env.update(extra)
    return env


def sh(*cmd, timeout=60, env=None):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, errors="replace",
                           timeout=timeout, env=env or child_env(), stdin=subprocess.DEVNULL)
    except FileNotFoundError:
        return subprocess.CompletedProcess(cmd, 127, "", "not found: " + cmd[0])
    except subprocess.TimeoutExpired:
        return subprocess.CompletedProcess(cmd, 124, "", "timed out: " + " ".join(cmd)[:120])
    if len(r.stdout) > SH_OUT_CAP:
        r.stdout = r.stdout[:SH_OUT_CAP]
    if len(r.stderr) > SH_OUT_CAP:
        r.stderr = r.stderr[:SH_OUT_CAP]
    return r


def _last_lines(text, n=4, cap=400):
    text = re.sub(r"\x1b\[[0-9;]*m", "", text or "")
    lines = [l.strip() for l in text.splitlines() if l.strip()]
    return " | ".join(lines[-n:])[:cap]


# --- systemd -----------------------------------------------------------------

def uctl(*a, timeout=60):
    return sh(SYSTEMCTL, "--user", *a, timeout=timeout)


def sctl(*a, timeout=60):
    return sh(SYSTEMCTL, "--no-ask-password", *a, timeout=timeout)


def user_active():
    return uctl("is-active", SERVICE).stdout.strip() == "active"


def tun_installed():
    # tun-install writes the unit and the polkit rule together; the rule can't
    # be checked as a user (rules.d is root:polkitd 0750). A missing rule
    # surfaces as "denied" from systemctl in start_service.
    try:
        return TUN_LAYOUT in SYS_UNIT.read_text()
    except OSError:
        return False


def tun_active():
    return uctl("is-active", T2S_SERVICE).stdout.strip() == "active"


def running_units():
    return user_active(), tun_active()


def journal_tail(tun, n=8):
    units = ["-u", SERVICE] + (["-u", T2S_SERVICE] if tun else [])
    r = sh(JOURNALCTL, "--user", *units, "-n", str(n), "-o", "cat", "--no-pager")
    return (r.stdout or "").strip()


def user_unit_text():
    a = asset_dir()
    env = "Environment=XRAY_LOCATION_ASSET=%s\n" % a if a and _UNIT_PATH_RE.match(a) else ""
    return ("[Unit]\n"
            "Description=Xray core (proxy mode) driven by omarchy-xray\n"
            "After=network-online.target\n\n"
            "[Service]\n"
            "ExecStart=%s run -c %s\n"
            # set at every start, a login start too: the session environment
            # does not survive a logout, so `on` alone would leave it empty
            "ExecStartPost=-%s proxy-sync\n"
            "%s"
            "NoNewPrivileges=true\n"
            "Restart=on-failure\n"
            "RestartSec=3\n\n"
            "[Install]\n"
            "WantedBy=default.target\n") % (XRAY, CONF, SELF, env)


def t2s_unit_text():
    # The root unit's device lives exactly as long as this unit: start it
    # first, stop it last (ExecStopPost also runs after a failed start).
    # Both go through `tun-unit`, which acts only on our own root unit.
    return ("[Unit]\n"
            "Description=omarchy-xray TUN mode: tun2socks on %(dev)s (no privileges)\n"
            "Wants=%(xray)s\n"
            "After=%(xray)s\n\n"
            "[Service]\n"
            "ExecStartPre=%(self)s tun-unit start\n"
            "ExecStart=%(self)s tun-run\n"
            # A crash keeps the root unit, so traffic stays in xray0 (blocked)
            # while systemd restarts tun2socks; only a deliberate stop - off,
            # a switch to proxy - removes the device and its routes.
            "ExecStopPost=-/bin/sh -c '[ \"$$SERVICE_RESULT\" = success ] && exec %(self)s tun-unit stop'\n"
            "NoNewPrivileges=true\n"
            "Restart=on-failure\n"
            "RestartSec=3\n\n"
            "[Install]\n"
            "WantedBy=default.target\n") % {
                "dev": TUN_NAME, "xray": SERVICE, "self": SELF}


def write_user_units():
    UNIT_DIR.mkdir(parents=True, exist_ok=True)
    changed = False
    for path, text in ((UNIT, user_unit_text()), (T2S_UNIT, t2s_unit_text())):
        try:
            cur = path.read_text()
        except OSError:
            cur = None
        if cur != text:
            atomic_write(path, text, 0o644)
            changed = True
    old = UNIT_DIR / "omarchy-xray-tun-login.service"   # v3.0: started the xray TUN unit
    if old.exists():
        uctl("disable", old.name)
        old.unlink()
        changed = True
    if changed:
        uctl("daemon-reload")


# --- state -------------------------------------------------------------------

def load_state():
    try:
        text = read_nofollow(STATE, 16 * 1024 * 1024)
    except ValueError as e:
        die(str(e))
    st = {}
    if text is not None:
        try:
            st = json.loads(text)
        except Exception:
            die("state.json is corrupt — restore it or re-import")
        if not isinstance(st, dict):
            die("state.json is corrupt")
    subs = []
    for s in st.get("subs", []) if isinstance(st.get("subs"), list) else []:
        if isinstance(s, str):
            s = {"url": s}                       # v2 stored bare URLs
        if isinstance(s, dict) and (isinstance(s.get("url"), str) or (
                isinstance(s.get("local"), list) and all(isinstance(t, str) for t in s["local"]))):
            subs.append(s)
    st["subs"] = subs[:MAX_SUBS]
    nodes = st.get("nodes") if isinstance(st.get("nodes"), list) else []
    # v2 nodes had no outbound; they are rebuilt on the next update.
    st["nodes"] = [n for n in nodes[:MAX_NODES]
                   if isinstance(n, dict) and isinstance(n.get("id"), str)
                   and isinstance(n.get("ob"), dict)]
    sel = st.get("selected", "")
    if isinstance(sel, int):
        sel = "n%d" % sel                        # v2 selected by index
    sel = sel if isinstance(sel, str) else ""
    if re.match(r"^n\d+$", sel) and int(sel[1:]) < len(st["nodes"]):
        sel = st["nodes"][int(sel[1:])]["id"]
    st["selected"] = sel
    if st.get("mode") not in ("proxy", "tun"):
        st["mode"] = "proxy"
    if st.get("routing") != "global" and not region_of(st.get("routing")):
        st["routing"] = "global"
    st["adblock"] = st.get("adblock") is True
    st["fragment"] = st.get("fragment") is True
    favs = st.get("favorites") if isinstance(st.get("favorites"), list) else []
    st["favorites"] = [f for f in favs if isinstance(f, str) and re.fullmatch(r"k[0-9a-f]{10}", f)][:MAX_FAVS]
    for k in ("autoFavorites", "lan", "mux"):
        st[k] = st.get(k) is True
    mc = st.get("muxConcurrency")
    st["muxConcurrency"] = mc if isinstance(mc, int) and not isinstance(mc, bool) and 1 <= mc <= 1024 else 8
    ua = st.get("userAgent")
    if not (isinstance(ua, str) and ua_ok(ua)):
        st.pop("userAgent", None)
    if not (isinstance(st.get("chain"), str) and any(n.get("id") == st["chain"] for n in st.get("nodes", []))):
        st["chain"] = ""
    gd = st.get("geoDays")
    if not (isinstance(gd, int) and not isinstance(gd, bool) and 0 <= gd <= 90):
        st.pop("geoDays", None)
    su = st.get("subUpdate")
    if not (isinstance(su, int) and not isinstance(su, bool) and 0 <= su <= 168):
        st.pop("subUpdate", None)
    if st.get("loglevel") not in LOGLEVELS:
        st["loglevel"] = "warning"
    la = st.get("lanAuth") if isinstance(st.get("lanAuth"), dict) else {}
    if not (isinstance(la.get("user"), str) and isinstance(la.get("pass"), str)
            and re.fullmatch(r"[0-9a-f]{8,64}", la["user"]) and re.fullmatch(r"[0-9a-f]{16,64}", la["pass"])):
        la = {"user": os.urandom(4).hex(), "pass": os.urandom(12).hex()}
    st["lanAuth"] = la
    fo = st.get("fragmentOpts") if isinstance(st.get("fragmentOpts"), dict) else {}
    st["fragmentOpts"] = {k: fo[k] if fragment_opt_ok(k, fo.get(k)) else v
                          for k, v in FRAGMENT_DEFAULTS.items()}
    rules = st.get("rules") if isinstance(st.get("rules"), list) else []
    st["rules"] = [r for r in rules if isinstance(r, dict) and r.get("target") in RULE_TARGETS
                   and isinstance(r.get("value"), str) and rule_match(r["value"])][:MAX_RULES]
    if not dns_custom_ok(st.get("dnsCustom")):
        st.pop("dnsCustom", None)
        if st.get("dns") == "custom":
            st["dns"] = "cloudflare"
    if st.get("dns") not in DNS_PRESETS:
        st["dns"] = "cloudflare"
    if not isinstance(st.get("skipped"), dict):
        st["skipped"] = {}
    st["version"] = 3
    return st


def save_state(st):
    _cfg_dir()
    atomic_write(STATE, json.dumps(st, indent=1, ensure_ascii=False), 0o600)


# --- subscription download ---------------------------------------------------

def check_https_url(url):
    if len(url or "") > MAX_URL_LEN:
        raise ValueError("subscription URL too long")
    u = urllib.parse.urlsplit(url or "")
    if u.scheme != "https" or not u.hostname:
        raise ValueError("subscription URL must be https://…")
    return u


@functools.lru_cache(maxsize=None)
def device_headers():
    """Remnawave-style device headers for panels with a device limit. The id
    is a salted hash of machine-id: stable per machine, not the id itself."""
    try:
        mid = (read_nofollow("/etc/machine-id", 64) or "").strip()
    except ValueError:
        mid = ""
    h = {"x-device-os": "Linux", "x-ver-os": os.uname().release[:64],
         "x-device-model": "omarchy-xray"}
    if mid:
        h["x-hwid"] = hashlib.sha256(("omarchy-xray:" + mid).encode()).hexdigest()[:16]
    return h


def ua_ok(ua):
    return 0 < len(ua) <= 128 and re.fullmatch(r"[\x20-\x7e]+", ua) is not None


def fetch(url, via_proxy=False, ua="", cap=MAX_SUB_BYTES):
    """Returns (body, headers). HTTPS only, byte-capped, redirect-checked."""
    import urllib.request

    class SafeRedirect(urllib.request.HTTPRedirectHandler):
        """Redirects must stay https and stop after a few hops."""
        count = 0

        def redirect_request(self, req, fp, code, msg, headers, newurl):
            self.count += 1
            if self.count > MAX_REDIRECTS:
                raise ValueError("too many redirects")
            final = urllib.parse.urljoin(req.full_url, newurl)
            if urllib.parse.urlsplit(final).scheme != "https":
                raise ValueError("redirect to non-https URL refused")
            return super().redirect_request(req, fp, code, msg, headers, newurl)

    check_https_url(url)
    handlers = [SafeRedirect()]
    if via_proxy:
        p = "http://127.0.0.1:%d" % HTTP
        handlers.append(urllib.request.ProxyHandler({"https": p, "http": p}))
    else:
        handlers.append(urllib.request.ProxyHandler({}))
    opener = urllib.request.build_opener(*handlers)
    req = urllib.request.Request(url, headers=dict(device_headers(),
                                 **{"User-Agent": ua or "omarchy-xray/" + VERSION, "Accept": "*/*"}))
    try:
        r = opener.open(req, timeout=FETCH_TIMEOUT)
    except ValueError:
        raise
    except Exception as e:
        raise RuntimeError("download failed: " + type(e).__name__)
    try:
        if urllib.parse.urlsplit(r.geturl()).scheme != "https":
            raise ValueError("final URL is not https — refused")
        buf = bytearray()
        while True:
            chunk = r.read(65536)
            if not chunk:
                break
            buf += chunk
            if len(buf) > cap:
                raise ValueError("download exceeds %d bytes — refused" % cap)
        headers = {k.lower(): v for k, v in r.headers.items()
                   if k.lower() in ("subscription-userinfo", "profile-title",
                                    "profile-update-interval")}
        return bytes(buf), headers
    finally:
        try:
            r.close()
        except Exception:
            pass


def parse_userinfo(value):
    """`upload=1; download=2; total=3; expire=4` -> dict of non-negative ints."""
    info = {}
    for part in str(value or "")[:512].split(";"):
        k, _, v = part.strip().partition("=")
        k = k.strip().lower()
        if k in ("upload", "download", "total", "expire"):
            try:
                n = int(float(v.strip()))
            except ValueError:
                continue
            if 0 <= n < 1 << 62:
                info[k] = n
    return info


def parse_title(value):
    v = str(value or "").strip()[:1024]
    if v.lower().startswith("base64:"):
        try:
            v = b64any(v[7:]).decode("utf-8", "replace")
        except ValueError:
            v = ""
    return clean_name(v)[:128]


def parse_interval(value):
    try:
        h = int(str(value or "").strip())
    except ValueError:
        return 0
    return h if 1 <= h <= 720 else 0


def b64any(s):
    """Decode std/urlsafe base64 with or without padding; ValueError if not base64."""
    s = re.sub(r"\s+", "", s if isinstance(s, str) else s.decode("ascii", "replace"))
    if not s or not re.match(r"^[A-Za-z0-9+/_=-]+$", s):
        raise ValueError("not base64")
    s = s.rstrip("=").replace("-", "+").replace("_", "/")
    s += "=" * (-len(s) % 4)
    try:
        return base64.b64decode(s, validate=True)
    except Exception:
        raise ValueError("not base64")


def split_body(body):
    """Subscription body -> ("links", [lines]) or ("json", data).
    Accepts plain text, std/urlsafe base64 (padded or not) and Xray JSON."""
    text = body.decode("utf-8", "replace").lstrip("\ufeff").strip()
    for attempt in (0, 1):
        if text[:1] in ("[", "{"):
            try:
                return "json", json.loads(text)
            except Exception:
                pass
        if "://" in text:
            lines = []
            for line in text.splitlines():
                line = line.strip()
                if "://" in line and len(line) <= MAX_LINE:
                    lines.append(line)
                if len(lines) >= MAX_LINKS:
                    break
            return "links", lines
        if attempt == 0:
            try:
                text = b64any(text).decode("utf-8", "replace").strip()
            except ValueError:
                return "links", []
    return "links", []


# --- share-link parsing ------------------------------------------------------

@functools.lru_cache(None)
def core_version():
    """(major, minor, patch) of the installed core, or None when unknown."""
    if not os.path.isfile(XRAY):
        return None
    m = re.search(r"Xray (\d+)\.(\d+)\.(\d+)", sh(XRAY, "version", timeout=15).stdout or "")
    return tuple(int(x) for x in m.groups()) if m else None


def ver_str(v):
    return ".".join(str(x) for x in v) if v else "unknown"


class Skip(ValueError):
    """A link that is well-formed enough to explain why it cannot be used."""


def clean_name(s):
    return _CTRL_RE.sub("", str(s or "")).strip()[:MAX_STR]


def _f(value, what, limit=MAX_STR, pattern=None):
    v = "" if value is None else str(value)
    if len(v) > limit or _CTRL_RE.search(v):
        raise ValueError("bad %s" % what)
    if pattern is not None and v != "" and not pattern.match(v):
        raise ValueError("bad %s" % what)
    return v


def is_ip(h):
    try:
        ipaddress.ip_address(h)
        return True
    except ValueError:
        return False


def check_host(h):
    h = (h or "").strip().strip("[]").rstrip(".")
    if not h or len(h) > 253:
        raise ValueError("bad host")
    if is_ip(h):
        return h
    if not _HOST_RE.match(h):
        raise ValueError("bad host")
    return h.lower()


def check_port(p, default=None):
    if p in (None, ""):
        if default is None:
            raise ValueError("bad port")
        return default
    try:
        n = int(str(p).strip())
    except ValueError:
        raise ValueError("bad port")
    if not 1 <= n <= 65535:
        raise ValueError("bad port")
    return n


def parse_query(query):
    """Query without parse_qs quirks: `+` stays `+` (keys, paths, base64)."""
    q = {}
    parts = [p for p in (query or "").split("&") if p]
    if len(parts) > 64:
        raise ValueError("too many query fields")
    for part in parts:
        k, _, v = part.partition("=")
        k = urllib.parse.unquote(k)
        v = urllib.parse.unquote(v)
        if len(k) > 64 or len(v) > MAX_PARAM:
            raise ValueError("bad query field")
        q.setdefault(k, v)
    return q


def user_id_ok(uid):
    """VLESS/VMess id: a UUID, or any string under 30 bytes (the core maps it
    to a UUIDv5 — docs: outbounds/vless `id`)."""
    if not uid or _CTRL_RE.search(uid) or any(c.isspace() for c in uid):
        return False
    return bool(_UUID_RE.match(uid)) or len(uid.encode("utf-8")) < 30


def _split_link(link, default_port):
    u = urllib.parse.urlsplit(link)
    host = check_host(u.hostname)
    try:
        port = check_port(u.port, default_port)
    except ValueError:
        raise ValueError("bad port")
    q = parse_query(u.query)
    name = clean_name(urllib.parse.unquote(u.fragment or "")) or host
    return u, host, port, q, name


def _userinfo(u):
    """Raw userinfo (everything before the last @), percent-decoded."""
    netloc = u.netloc
    if "@" not in netloc:
        return ""
    return urllib.parse.unquote(netloc.rpartition("@")[0])


def _json_param(v, what):
    if not v:
        return None
    try:
        obj = json.loads(v)
    except Exception:
        raise ValueError("bad %s JSON" % what)
    if not isinstance(obj, dict):
        raise ValueError("bad %s JSON" % what)
    return obj


def _fp(v):
    v = (v or "").strip().lower()
    return v if v in FINGERPRINTS else "chrome"


def _alpn(v):
    items = [a.strip() for a in (v or "").split(",") if a.strip()]
    return [a for a in items if a in ALPNS][:3]


def _pcs(v):
    out = []
    for item in (v or "").split(","):
        h = item.strip().replace(":", "").lower()
        if re.match(r"^[0-9a-f]{64}$", h):
            out.append(h)
    return ",".join(out[:8])


def tls_settings(q, host, alpn_default=None):
    sni = _f(q.get("sni") or q.get("peer") or "", "sni", 253)
    if sni:
        sni = check_host(sni)
    ts = {}
    if sni or not is_ip(host):
        ts["serverName"] = sni or host
    ts["fingerprint"] = _fp(q.get("fp"))
    alpn = _alpn(q.get("alpn")) or (alpn_default or [])
    if alpn:
        ts["alpn"] = alpn
    pcs = _pcs(q.get("pcs") or q.get("pinSHA256") or "")
    if pcs:
        ts["pinnedPeerCertSha256"] = pcs
    vcn = [check_host(x) for x in (q.get("vcn") or "").split(",") if x.strip()][:8]
    if vcn:
        ts["verifyPeerCertByName"] = ",".join(vcn)
    ech = q.get("ech") or ""
    if ech:
        ts["echConfigList"] = _f(ech, "ech", 4096, _ECH_RE)
    # `allowInsecure` was removed from Xray-core (pcs/vcn replace it); an
    # insecure=1 link is used with normal certificate verification.
    return ts


def stream_settings(q, host, default_security):
    """Share-link query -> (streamSettings, network, security)."""
    typ = (q.get("type") or "tcp").strip().lower()
    if typ in REMOVED_NETS:
        raise Skip("transport %s was removed from Xray core (use XHTTP)" % typ)
    net = NETS.get(typ)
    if net is None:
        raise Skip("unsupported transport: " + typ[:24])
    sec = (q.get("security") or default_security).strip().lower()
    if sec in ("", "none"):
        sec = "none"
    if sec == "xtls":
        raise Skip("legacy XTLS was removed from Xray core")
    if sec not in ("tls", "reality", "none"):
        raise Skip("unsupported security: " + sec[:24])
    if sec == "reality" and net not in ("raw", "xhttp", "grpc"):
        raise Skip("REALITY only supports RAW, XHTTP and gRPC")
    s = {"network": net, "security": sec}
    path = _f(q.get("path", ""), "path", 2048)
    hostp = _f(q.get("host", ""), "host param", 1024)
    first_host = hostp.split(",")[0].strip()
    if net == "raw":
        if (q.get("headerType") or "").lower() == "http":
            req = {"path": [p for p in path.split(",") if p] or ["/"]}
            hosts = [h.strip() for h in hostp.split(",") if h.strip()]
            if hosts:
                req["headers"] = {"Host": hosts}
            s["rawSettings"] = {"header": {"type": "http", "request": req}}
    elif net in ("ws", "httpupgrade"):
        t = {"path": path or "/"}
        if first_host:
            t["host"] = first_host
        s["wsSettings" if net == "ws" else "httpupgradeSettings"] = t
    elif net == "grpc":
        g = {"serviceName": _f(q.get("serviceName") or "", "serviceName", 512),
             "multiMode": (q.get("mode") or "").lower() == "multi"}
        auth = q.get("authority") or ""
        if auth:
            g["authority"] = _f(auth, "authority", 253)
        s["grpcSettings"] = g
    elif net == "xhttp":
        x = {"path": path or "/"}
        mode = (q.get("mode") or "auto").lower()
        x["mode"] = mode if mode in XHTTP_MODES else "auto"
        if first_host:
            x["host"] = first_host
        extra = _json_param(q.get("extra"), "xhttp extra")
        if extra:
            x["extra"] = extra
        s["xhttpSettings"] = x
    elif net == "kcp":
        kcp = {}
        for key, lo, hi in (("mtu", 576, 1460), ("tti", 10, 100)):
            v = q.get(key) or ""
            if v.isdigit() and lo <= int(v) <= hi:
                kcp[key] = int(v)
        s["kcpSettings"] = kcp
        # mKCP `seed`/`header` and the old default XOR obfuscation moved to
        # finalmask `mkcp-legacy` in Xray-core. Legacy servers apply the
        # obfuscation (AES-128-GCM with a seed, XOR without) under the packet
        # header, and the first finalmask item is the innermost layer.
        seed = _f(q.get("seed") or "", "kcp seed", 256)
        masks = [{"type": "mkcp-legacy", "settings": {"value": seed}} if seed
                 else {"type": "mkcp-legacy"}]
        ht = (q.get("headerType") or "none").lower()
        if ht not in ("", "none"):
            hdr = KCP_HEADERS.get(ht)
            if hdr is None:
                raise Skip("unsupported mKCP header: " + ht[:24])
            ms = {"header": hdr}
            if hdr == "dns" and first_host:
                ms["value"] = first_host
            masks.append({"type": "mkcp-legacy", "settings": ms})
        s["finalmask"] = {"udp": masks}
    if sec == "tls":
        s["tlsSettings"] = tls_settings(q, host)
    elif sec == "reality":
        # REALITY public key: raw-url base64 of 32 bytes. The docs now call the
        # field `password`; `publicKey` is accepted by every core version.
        pbk = _f(q.get("pbk") or q.get("password") or "", "pbk", 64, _PBK_RE)
        if not pbk:
            raise ValueError("REALITY link without a valid pbk")
        sni = _f(q.get("sni") or "", "sni", 253)
        r = {"serverName": check_host(sni) if sni else host,
             "fingerprint": _fp(q.get("fp")),
             "publicKey": pbk,
             "shortId": _f(q.get("sid") or "", "sid", 16, _SID_RE),
             "spiderX": _f(q.get("spx") or "/", "spx", 512)}
        pqv = q.get("pqv") or ""
        if pqv:
            r["mldsa65Verify"] = _f(pqv, "pqv", 4096, _B64URL_RE)
        s["realitySettings"] = r
    fm = _json_param(q.get("fm"), "finalmask")
    if fm:
        s["finalmask"] = fm
    return s, net, sec


_PRIVATE_SUFFIXES = (".local", ".lan", ".internal", ".home.arpa", ".localhost")


def is_private_host(h):
    try:
        a = ipaddress.ip_address(h)
        return a.is_private or a.is_loopback or a.is_link_local
    except ValueError:
        h = h.lower().rstrip(".")
        return h == "localhost" or h.endswith(_PRIVATE_SUFFIXES)


def require_transport_security(proto, host, sec):
    """Xray-core refuses VLESS/Trojan without TLS/REALITY (or VLESS
    encryption) to public addresses (infra/conf validateOutboundTransportSecurity)."""
    ver = core_version()
    if ver is not None and ver < PLAIN_REFUSED_CORE:
        return
    if sec == "none" and not is_private_host(host):
        raise Skip("%s without TLS/REALITY to a public server is refused by Xray core" % proto)


def _node(proto, host, port, name, ob, net, sec):
    return {"name": name, "proto": proto, "host": host, "port": port,
            "net": net, "sec": sec, "ob": ob}


def parse_vless(link):
    u, host, port, q, name = _split_link(link, 443)
    uid = _userinfo(u)
    if not user_id_ok(uid):
        raise ValueError("bad user id")
    enc = q.get("encryption") or "none"
    if not _ENC_RE.match(enc):
        raise ValueError("bad encryption param")
    flow = _f(q.get("flow") or "", "flow", 64, _FLOW_RE)
    s, net, sec = stream_settings(q, host, "none")
    if enc == "none":
        require_transport_security("VLESS", host, sec)
    user = {"id": uid, "encryption": enc}
    if flow:
        user["flow"] = flow
    ob = {"protocol": "vless",
          "settings": {"vnext": [{"address": host, "port": port, "users": [user]}]},
          "streamSettings": s}
    return _node("vless", host, port, name, ob, net, sec)


def parse_vmess(link):
    payload = link[len("vmess://"):].split("#", 1)[0].strip()
    if "@" in payload:                            # vmess://uuid@host:port?… form
        u, host, port, q, name = _split_link(link, 443)
        uid = _userinfo(u)
        scy = (q.get("encryption") or "auto").lower()
    else:
        try:
            data = json.loads(b64any(payload).decode("utf-8", "replace"))
        except (ValueError, json.JSONDecodeError):
            raise ValueError("bad vmess payload")
        if not isinstance(data, dict):
            raise ValueError("bad vmess payload")
        g = lambda k: _f(data.get(k) if data.get(k) is not None else "", k, MAX_PARAM)
        host = check_host(g("add"))
        port = check_port(g("port"), 443)
        uid = g("id")
        scy = (g("scy") or "auto").lower()
        name = clean_name(g("ps")) or host
        net = (g("net") or "tcp").lower()
        q = {"type": net, "headerType": g("type"), "host": g("host"), "path": g("path"),
             "security": g("tls") or "none", "sni": g("sni"),
             "alpn": g("alpn") or g("alp"), "fp": g("fp"),
             "pbk": g("pbk"), "sid": g("sid"), "spx": g("spx")}
        if net == "grpc":
            q["serviceName"] = g("path")
            q["mode"] = "multi" if g("type").lower() == "multi" else ""
        elif net in ("kcp", "mkcp"):
            q["seed"] = g("path")
        elif net in ("xhttp", "splithttp"):
            q["mode"] = g("type") if g("type") in XHTTP_MODES else "auto"
    if not user_id_ok(uid or ""):
        raise ValueError("bad user id")
    if scy not in VMESS_SECURITY:
        scy = "auto"
    s, net, sec = stream_settings(q, host, "none")
    ob = {"protocol": "vmess",
          "settings": {"vnext": [{"address": host, "port": port,
                                  "users": [{"id": uid, "security": scy}]}]},
          "streamSettings": s}
    return _node("vmess", host, port, name, ob, net, sec)


def parse_trojan(link):
    u, host, port, q, name = _split_link(link, 443)
    pw = _userinfo(u)
    if not pw or len(pw) > MAX_STR or _CTRL_RE.search(pw):
        raise ValueError("bad password")
    s, net, sec = stream_settings(q, host, "tls")
    require_transport_security("Trojan", host, sec)
    srv = {"address": host, "port": port, "password": pw}
    flow = _f(q.get("flow") or "", "flow", 64, _FLOW_RE)
    if flow:
        srv["flow"] = flow
    ob = {"protocol": "trojan", "settings": {"servers": [srv]}, "streamSettings": s}
    return _node("trojan", host, port, name, ob, net, sec)


def parse_ss(link):
    body, _, frag = link[len("ss://"):].partition("#")
    name_raw = urllib.parse.unquote(frag)
    main, _, query = body.partition("?")
    main = main.rstrip("/")
    if "@" not in main:                           # legacy: base64(method:pass@host:port)
        try:
            main = b64any(main).decode("utf-8", "replace")
        except ValueError:
            raise ValueError("bad ss payload")
        if "@" not in main:
            raise ValueError("bad ss payload")
        userinfo, _, hostport = main.rpartition("@")
    else:                                         # SIP002
        userinfo, _, hostport = main.rpartition("@")
        userinfo = urllib.parse.unquote(userinfo)
        if ":" not in userinfo:
            try:
                userinfo = b64any(userinfo).decode("utf-8", "replace")
            except ValueError:
                raise ValueError("bad ss userinfo")
    method, _, pw = userinfo.partition(":")
    method = SS_METHODS.get(method.strip().lower())
    if method is None:
        raise Skip("unsupported shadowsocks method")
    if len(pw) > MAX_STR or _CTRL_RE.search(pw) or (not pw and method != "none"):
        raise ValueError("bad password")
    u = urllib.parse.urlsplit("ss://x@" + hostport)
    host = check_host(u.hostname)
    port = check_port(u.port)
    q = parse_query(query)
    if q.get("plugin"):
        raise Skip("shadowsocks plugins are not supported by Xray")
    name = clean_name(name_raw) or host
    ob = {"protocol": "shadowsocks",
          "settings": {"servers": [{"address": host, "port": port,
                                    "method": method, "password": pw}]}}
    net, sec = "raw", "none"
    if (q.get("type") or "tcp").lower() not in ("tcp", "raw", ""):
        s, net, sec = stream_settings(q, host, "none")
        ob["streamSettings"] = s
    return _node("shadowsocks", host, port, name, ob, net, sec)


def parse_hy2(link):
    link = re.sub(r"^hy2://", "hysteria2://", link, flags=re.I)
    u = urllib.parse.urlsplit(link)
    host = check_host(u.hostname)
    hop = ""
    try:
        port = check_port(u.port, 443)
    except ValueError:
        # port hopping ("443,20000-30000"): dial the first, hop over all
        m = re.search(r":((\d{1,5})(?:[,-]\d{1,5})*)$", u.netloc)
        if not m:
            raise ValueError("bad port")
        port = check_port(m.group(2))
        hop = m.group(1)
    auth = urllib.parse.unquote(u.username or "")
    if u.password is not None:
        auth += ":" + urllib.parse.unquote(u.password)
    if len(auth) > MAX_STR or _CTRL_RE.search(auth):
        raise ValueError("bad auth")
    q = parse_query(u.query)
    name = clean_name(urllib.parse.unquote(u.fragment or "")) or host
    ts = tls_settings(q, host, ["h3"])
    ts.pop("fingerprint", None)                   # QUIC: uTLS fingerprints do not apply
    s = {"network": "hysteria", "security": "tls", "tlsSettings": ts,
         "hysteriaSettings": {"version": 2, "auth": auth}}
    hop = q.get("mport") or hop
    if hop and not re.fullmatch(r"\d{1,5}(-\d{1,5})?(,\d{1,5}(-\d{1,5})?){0,31}", hop):
        raise ValueError("bad port range")
    masks = []
    if hop:
        # udphop dials itself, so the core wants it first (finalmask: HandleDial)
        masks.append({"type": "udphop", "settings": {"mode": "intervalRemote", "interval": 30,
                                                     "remotePorts": hop}})
    obfs = (q.get("obfs") or "").lower()
    if obfs:
        if obfs != "salamander":
            raise Skip("unsupported hysteria2 obfs: " + obfs[:24])
        pw = _f(q.get("obfs-password") or "", "obfs-password", MAX_STR)
        masks.append({"type": "salamander", "settings": {"password": pw}})
    if masks:
        s["finalmask"] = {"udp": masks}
    ob = {"protocol": "hysteria",
          "settings": {"version": 2, "address": host, "port": port},
          "streamSettings": s}
    return _node("hysteria", host, port, name, ob, "hysteria", "tls")


PARSERS = {"vless": parse_vless, "vmess": parse_vmess, "trojan": parse_trojan,
           "ss": parse_ss, "hysteria2": parse_hy2, "hy2": parse_hy2}


def parse_link(link):
    if len(link) > MAX_LINE:
        raise ValueError("link line too long")
    scheme = link.split("://", 1)[0].lower() if "://" in link else ""
    fn = PARSERS.get(scheme)
    if fn is None:
        raise Skip("unsupported link type: " + (scheme[:16] or "?"))
    n = fn(link)
    n["link"] = link                     # for `share`; state.json is 0600 like the rest
    return n


def _ob_endpoint(ob):
    st = ob.get("settings") or {}
    for key in ("vnext", "servers"):
        lst = st.get(key)
        if isinstance(lst, list) and lst and isinstance(lst[0], dict):
            return lst[0].get("address"), lst[0].get("port")
    return st.get("address"), st.get("port")


def node_from_json_config(cfg):
    """One entry of an Xray-JSON subscription -> node (its proxy outbound)."""
    obs = cfg.get("outbounds") if isinstance(cfg, dict) else None
    if not isinstance(obs, list):
        raise ValueError("no outbounds")
    cands = [o for o in obs if isinstance(o, dict) and o.get("protocol") in PROTOCOLS]
    if not cands:
        raise Skip("no supported outbound in JSON config")
    pick = next((o for o in cands if o.get("tag") in ("proxy", "", None)), cands[0])
    ob = copy.deepcopy(pick)
    for k in ("tag", "proxySettings", "sendThrough"):
        ob.pop(k, None)
    ss = ob.get("streamSettings")
    if isinstance(ss, dict) and isinstance(ss.get("sockopt"), dict):
        ss["sockopt"].pop("dialerProxy", None)   # chained outbounds are not imported
    if len(json.dumps(ob)) > MAX_OB_JSON:
        raise ValueError("outbound too large")
    addr, port = _ob_endpoint(ob)
    host = check_host(str(addr or ""))
    port = check_port(port)
    net = str((ss or {}).get("network") or "raw") if isinstance(ss, dict) else "raw"
    if net in REMOVED_NETS:
        raise Skip("transport %s was removed from Xray core (use XHTTP)" % net)
    sec = str((ss or {}).get("security") or "none") if isinstance(ss, dict) else "none"
    name = clean_name(cfg.get("remarks") or "") or host
    return _node(ob["protocol"], host, port, name, ob, NETS.get(net, net)[:16], sec[:16])


def node_id(ob):
    return "k" + hashlib.sha1(json.dumps(ob, sort_keys=True).encode()).hexdigest()[:10]


def nodes_from_body(body, sub_index, skipped):
    kind, data = split_body(body)
    items = []
    if kind == "json":
        for cfg in (data if isinstance(data, list) else [data])[:MAX_LINKS]:
            if isinstance(cfg, dict) and "protocol" in cfg and "outbounds" not in cfg:
                cfg = {"outbounds": [cfg]}             # one outbound, not a whole config
            try:
                items.append(node_from_json_config(cfg))
            except Skip as e:
                skipped[str(e)] = skipped.get(str(e), 0) + 1
            except ValueError:
                skipped["malformed"] = skipped.get("malformed", 0) + 1
    else:
        for link in data:
            try:
                items.append(parse_link(link))
            except Skip as e:
                skipped[str(e)] = skipped.get(str(e), 0) + 1
            except ValueError:
                skipped["malformed"] = skipped.get("malformed", 0) + 1
    for n in items:
        n["sub"] = sub_index
        n["id"] = node_id(n["ob"])
    return items


# --- core validation ---------------------------------------------------------

def xray_test_config(conf):
    """Run `xray run -test` on a config dict. Returns "" when accepted, else
    the core's error text."""
    if not os.path.isfile(XRAY):
        return "xray core not found (%s)" % XRAY
    fd, path = tempfile.mkstemp(dir=str(runtime_dir()), prefix="test-", suffix=".json")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(conf, f)
        r = sh(XRAY, "run", "-test", "-c", path, timeout=60)
    finally:
        try:
            os.unlink(path)
        except OSError:
            pass
    if r.returncode == 0:
        return ""
    return core_error((r.stdout or "") + "\n" + (r.stderr or "")) or "exit %d" % r.returncode


def core_error(text):
    """The useful tail of an xray error chain (`… > infra/conf: reason`)."""
    text = re.sub(r"\x1b\[[0-9;]*m", "", text or "")
    for line in reversed(text.splitlines()):
        if "Failed to start" in line or "failed to" in line.lower():
            segs = [x.strip() for x in line.split(" > ") if x.strip()]
            return " > ".join(segs[-2:])[:300]
    return _last_lines(text, n=2, cap=300)


def core_filter(nodes, skipped):
    """Drop nodes the installed core rejects (one bad outbound must never
    break the tunnel). Bisects a single-config test; bounded run count."""
    if not nodes or not os.path.isfile(XRAY):
        return nodes
    budget = [48]

    def conf_for(group):
        obs = []
        for i, n in enumerate(group):
            ob = copy.deepcopy(n["ob"])
            ob["tag"] = "t%d" % i
            obs.append(ob)
        return {"log": {"loglevel": "none"}, "outbounds": obs}

    def bad(group):
        if budget[0] <= 0:
            return []
        budget[0] -= 1
        if xray_test_config(conf_for(group)) == "":
            return []
        if len(group) == 1:
            return group
        mid = len(group) // 2
        return bad(group[:mid]) + bad(group[mid:])

    rejected = {id(n) for n in bad(nodes)}
    if rejected:
        skipped["rejected by xray core"] = skipped.get("rejected by xray core", 0) + len(rejected)
    return [n for n in nodes if id(n) not in rejected]


# --- fetching ----------------------------------------------------------------

def fetch_subs(st, only=None):
    """Re-fetch subscriptions. `only` limits the refresh to one index and
    keeps other subscriptions' nodes as they are."""
    skipped = {}
    nodes = []
    running = any(running_units())
    for i, sub in enumerate(st["subs"]):
        if only is not None and i != only:
            nodes.extend(n for n in st["nodes"] if n.get("sub") == i)
            continue
        url = sub.get("url")
        try:
            if url is None:                        # Manual group: parse what was pasted
                got = [n for t in sub["local"] for n in nodes_from_body(t.encode(), i, skipped)]
            else:
                try:
                    body, headers = fetch(url, ua=st.get("userAgent", ""))
                except (RuntimeError, OSError):
                    if not running:
                        raise
                    body, headers = fetch(url, via_proxy=True, ua=st.get("userAgent", ""))   # direct blocked? try the tunnel
                got = nodes_from_body(body, i, skipped)
                sub["info"] = parse_userinfo(headers.get("subscription-userinfo"))
                sub["title"] = parse_title(headers.get("profile-title"))
                sub["interval"] = parse_interval(headers.get("profile-update-interval"))
            sub["fetched"] = int(time.time())
            sub["error"] = "" if got else "no usable nodes"
            nodes.extend(got)
        except Exception as e:
            sub["error"] = re.sub(r"[A-Za-z][\w+.-]*://\S+", lambda m: redact_url(m.group(0)), str(e))[:200]
            sub["fetched"] = int(time.time())
            nodes.extend(n for n in st["nodes"] if n.get("sub") == i)  # keep last good
            print("warn: fetch failed for %s: %s" % (redact_url(url), e), file=sys.stderr)
        if len(nodes) >= MAX_NODES:
            print("warn: node cap reached (%d) — rest ignored" % MAX_NODES, file=sys.stderr)
            break
    seen, uniq = set(), []
    for n in nodes:
        if n["id"] not in seen:
            seen.add(n["id"])
            uniq.append(n)
    uniq = core_filter(uniq[:MAX_NODES], skipped)
    st["skipped"] = skipped
    return uniq


def resolve_selection(st, prev_sel, prev_name):
    ids = {n["id"] for n in st["nodes"]}
    if not st["nodes"]:
        st["selected"] = ""
    elif prev_sel == "auto" and len(st["nodes"]) > 1:
        st["selected"] = "auto"
    elif prev_sel in ids:
        st["selected"] = prev_sel
    elif re.match(r"^n\d+$", prev_sel or "") and int(prev_sel[1:]) < len(st["nodes"]):
        st["selected"] = st["nodes"][int(prev_sel[1:])]["id"]
    else:
        same = [n for n in st["nodes"] if prev_name and n["name"] == prev_name]
        st["selected"] = (same[0] if same else st["nodes"][0])["id"]


def selected_node(st):
    for n in st["nodes"]:
        if n["id"] == st["selected"]:
            return n
    return st["nodes"][0] if st["nodes"] else None


# --- config generation -------------------------------------------------------

def deep_merge(dst, src):
    for k, v in src.items():
        if isinstance(v, dict) and isinstance(dst.get(k), dict):
            deep_merge(dst[k], v)
        else:
            dst[k] = copy.deepcopy(v)
    return dst


def load_custom():
    try:
        text = read_nofollow(CUSTOM, MAX_CUSTOM)
    except ValueError as e:
        die("custom.json: " + str(e))
    if text is None or not text.strip():
        return {}
    try:
        c = json.loads(text)
    except Exception as e:
        die("custom.json is not valid JSON: %s" % e)
    if not isinstance(c, dict):
        die("custom.json must be a JSON object")
    return c


def _route_lines():
    r = sh(IP, "-4", "-o", "route", "show", "default", timeout=10)
    return [l.split() for l in (r.stdout or "").splitlines() if l.strip()]


def default_dev():
    """Physical egress interface: lowest-metric default route not via TUN."""
    best, best_metric = None, None
    for toks in _route_lines():
        if "dev" not in toks:
            continue
        dev = toks[toks.index("dev") + 1]
        if dev == TUN_NAME:
            continue
        metric = int(toks[toks.index("metric") + 1]) if "metric" in toks else 0
        if best is None or metric < best_metric:
            best, best_metric = dev, metric
    return best


def bound_iface():
    """Interface the current config binds xray's connections to (TUN mode)."""
    for ob in load_json(CONF, {}).get("outbounds", []):
        if isinstance(ob, dict) and ob.get("tag") == "direct":
            return ob.get("streamSettings", {}).get("sockopt", {}).get("interface")
    return None


def link_dns(dev):
    """IPv4 DNS servers systemd-resolved uses on the physical link."""
    rv = tool("resolvectl")
    if not rv or not dev:
        return []
    r = sh(rv, "dns", dev, timeout=10)
    found = []
    for tok in re.split(r"[\s,]+", (r.stdout or "").partition(":")[2]):
        tok = tok.split("#")[0]
        try:
            a = ipaddress.ip_address(tok)
        except ValueError:
            continue
        if a.version == 4 and not a.is_loopback and str(a) != TUN_DNS:
            found.append(str(a))
    return found[:2]


def bootstrap_dns(custom):
    boot = custom.get("bootstrapDns")
    if isinstance(boot, list):
        return [str(b) for b in boot if isinstance(b, str)][:4]
    return (link_dns(default_dev()) + ["1.1.1.1"])[:3]


def auto_members(st):
    """Balancer members: best measured latency first, then subscription order."""
    lat = load_json(LAT, {})

    def ms(n):
        m = re.match(r"^(\d+)ms$", str(lat.get(n["id"], "")))
        return int(m.group(1)) if m else None

    pool = st["nodes"]
    if st.get("autoFavorites"):
        favs = set(st.get("favorites", []))
        pool = [n for n in pool if n["id"] in favs] or pool     # no starred node left: all
    good = sorted((n for n in pool if ms(n) is not None), key=ms)
    rest = [n for n in pool if ms(n) is None and lat.get(n["id"]) != "timeout"]
    return (good + rest)[:AUTO_MAX] or pool[:AUTO_MAX]


def node_outbound(n, tag, mode, patch=None, iface=None):
    ob = copy.deepcopy(n["ob"])
    ob["tag"] = tag
    if patch:
        deep_merge(ob, patch)
    if mode == "tun" and not is_ip(n["host"]):
        # Resolve the server through Xray's DNS (bootstrap servers, sent
        # direct) instead of the system resolver, which points into the TUN.
        so = ob.setdefault("streamSettings", {}).setdefault("sockopt", {})
        so.setdefault("domainStrategy", "UseIPv4v6")
    if iface:
        ob.setdefault("streamSettings", {}).setdefault("sockopt", {})["interface"] = iface
    return ob


RULE_TARGETS = ("direct", "proxy", "block")
MAX_RULES = 200
_DOMAIN_RE = re.compile(r"^(?=.{1,253}$)([a-z0-9_]([a-z0-9_-]{0,61}[a-z0-9_])?\.)*[a-z0-9-]{1,63}$")


def rule_match(value):
    """A user rule's value -> ("domain"|"ip", xray matcher), or None."""
    v = value.strip().lower()
    if re.fullmatch(r"geo(site|ip):[a-z0-9!@._-]{1,64}", v):
        return ("domain" if v.startswith("geosite:") else "ip"), v
    try:
        return "ip", str(ipaddress.ip_network(v, strict=False))
    except ValueError:
        pass
    v = v.removeprefix("domain:").strip(".")
    return ("domain", "domain:" + v) if _DOMAIN_RE.match(v) else None


def user_rules(st, target):
    """One xray rule per user rule, in the user's order."""
    out = []
    for r in st.get("rules", []):
        kind, m = rule_match(r["value"])
        to = target if r["target"] == "proxy" else {"outboundTag": r["target"]}
        out.append(dict({kind: [m]}, **to))
    return out


FRAGMENT_DEFAULTS = {"packets": "tlshello", "length": "100-200", "interval": "10-20"}


def fragment_opt_ok(key, v):
    """packets: tlshello or a packet range; length/interval: "N" or "N-M"."""
    if not isinstance(v, str) or key not in FRAGMENT_DEFAULTS:
        return False
    if key == "packets" and v == "tlshello":
        return True
    m = re.fullmatch(r"(\d{1,4})(?:-(\d{1,4}))?", v)
    return bool(m) and int(m.group(1)) <= int(m.group(2) or m.group(1)) \
        and (key == "interval" or int(m.group(1)) > 0)


def mux_target(ob):
    """Mux breaks XTLS Vision (flow) and has no place on XHTTP or QUIC."""
    ss = ob.get("streamSettings") or {}
    return (ob.get("protocol") in ("vless", "vmess", "trojan", "shadowsocks")
            and ss.get("network") not in ("xhttp", "hysteria") and '"flow": "xtls' not in json.dumps(ob))


def lan_ip():
    dev = default_dev()
    if not dev:
        return ""
    r = sh(IP, "-4", "-o", "addr", "show", "dev", dev, timeout=5)
    m = re.search(r"inet (\d+\.\d+\.\d+\.\d+)/", r.stdout or "")
    return m.group(1) if m else ""


def fragment_target(ob):
    """TLS over TCP only: REALITY and QUIC transports gain nothing from it."""
    ss = ob.get("streamSettings") or {}
    return ss.get("security") == "tls" and ss.get("network") not in ("hysteria", "kcp")


def build_config(st, custom=None):
    custom = custom or {}
    mode = st["mode"]
    geo = asset_dir() is not None
    auto = st["selected"] == "auto" and len(st["nodes"]) > 1
    members = auto_members(st) if auto else [selected_node(st)]
    target = {"balancerTag": "auto"} if auto else {"outboundTag": "proxy"}
    patch = custom.get("proxyPatch") if isinstance(custom.get("proxyPatch"), dict) else None

    # TUN traffic arrives as bare IPs: let the sniffed domain replace them, so
    # the server resolves it (routeOnly keeps proxy-mode apps' own choice).
    sniff = {"enabled": True, "destOverride": ["http", "tls", "quic"], "routeOnly": mode != "tun"}
    inbounds = [
        {"tag": "socks-in", "listen": "127.0.0.1", "port": SOCKS, "protocol": "socks",
         "settings": {"auth": "noauth", "udp": True}, "sniffing": sniff},
        {"tag": "http-in", "listen": "127.0.0.1", "port": HTTP, "protocol": "http",
         "settings": {}, "sniffing": sniff},
    ]
    if st.get("lan"):
        acc = [{"user": st["lanAuth"]["user"], "pass": st["lanAuth"]["pass"]}]
        inbounds += [
            {"tag": "lan-socks", "listen": "0.0.0.0", "port": LAN_SOCKS, "protocol": "socks",
             "settings": {"auth": "password", "accounts": acc, "udp": True}, "sniffing": sniff},
            {"tag": "lan-http", "listen": "0.0.0.0", "port": LAN_HTTP, "protocol": "http",
             "settings": {"accounts": acc}, "sniffing": sniff}]
    if auto:
        outbounds = [node_outbound(n, "node-%d" % i, mode, patch) for i, n in enumerate(members)]
    else:
        outbounds = [node_outbound(members[0], "proxy", mode, patch)]
    hop = next((n for n in st["nodes"] if n["id"] == st.get("chain")), None)
    if hop:
        # chain: every exit node is dialed through the first hop; a node is
        # never chained through itself
        for n, ob in zip(members, outbounds):
            if n["id"] != hop["id"]:
                ob.setdefault("streamSettings", {}).setdefault("sockopt", {})["dialerProxy"] = "chain-hop"
        outbounds.append(node_outbound(hop, "chain-hop", mode, patch))
    if st.get("mux"):
        for ob in outbounds:
            if mux_target(ob):
                ob.setdefault("mux", {"enabled": True, "concurrency": st.get("muxConcurrency", 8)})
    direct = {"tag": "direct", "protocol": "freedom"}
    if mode == "tun":
        # docs (outbounds/freedom): resolution is controlled by sockopt.domainStrategy;
        # resolve via Xray's DNS instead of the system resolver pointed into the TUN.
        direct["streamSettings"] = {"sockopt": {"domainStrategy": "UseIP"}}
    outbounds += [direct, {"tag": "block", "protocol": "blackhole"}]
    if st.get("fragment"):
        # with a chain only the hop talks to the network itself
        frag = [ob for ob in outbounds if fragment_target(ob)
                and (not hop or ob["tag"] == "chain-hop" or "dialerProxy" not in ob["streamSettings"].get("sockopt", {}))]
        if frag:
            opts = st.get("fragmentOpts") or FRAGMENT_DEFAULTS
            outbounds.append(dict(copy.deepcopy(direct), tag="tls-fragment",
                                  settings={"fragment": dict(opts)}))
        for ob in frag:
            ob["streamSettings"].setdefault("sockopt", {})["dialerProxy"] = "tls-fragment"

    rules, conf = [], {}
    iface = None
    if mode == "tun":
        # tun2socks hands xray every connection from xray0 via socks-in.
        iface = default_dev() or bound_iface()
        if not iface:
            die("TUN mode needs a network connection (no default route)")
        # No rules: A/AAAA go to the built-in DNS, other query types get an
        # immediate empty answer (docs: outbounds/dns, fallback rule).
        outbounds.append({"tag": "dns-out", "protocol": "dns"})
        hosts = {n["host"] for n in members if not is_ip(n["host"])}
        own = st.get("dnsCustom") if st.get("dns") == "custom" else ""
        if own and not is_ip(own) and not is_ip(urllib.parse.urlsplit(own).hostname or ""):
            hosts.add(urllib.parse.urlsplit(own).hostname)    # the DoH/DoT name itself
        hosts = sorted(hosts)
        servers = []
        if hosts:
            for b in bootstrap_dns(custom):
                servers.append({"address": b, "domains": ["full:" + h for h in hosts],
                                "skipFallback": True, "tag": "dns-bootstrap"})
        system = st.get("dns") == "system"
        if system:
            servers += bootstrap_dns(custom)
        else:
            servers.append((st.get("dnsCustom") if st.get("dns") == "custom" else DNS_PRESETS.get(st.get("dns")))
                           or DNS_PRESETS["cloudflare"])
        conf["dns"] = {"servers": servers, "tag": "dns-internal"}
        rules += [{"inboundTag": ["socks-in"], "port": "53", "outboundTag": "dns-out"},
                  {"inboundTag": ["dns-bootstrap"], "outboundTag": "direct"},
                  {"inboundTag": ["dns-internal"], "outboundTag": "direct"} if system
                  else dict({"inboundTag": ["dns-internal"]}, **target)]

    croute = custom.get("routing") if isinstance(custom.get("routing"), dict) else {}
    if isinstance(croute.get("rules"), list):
        rules += copy.deepcopy(croute["rules"])
    rules += user_rules(st, target)
    if st["adblock"] and geo:
        rules.append({"domain": ["geosite:category-ads-all"], "outboundTag": "block"})
    rules.append({"ip": ["geoip:private"] if geo else PRIVATE, "outboundTag": "direct"})
    cc = region_of(st["routing"])
    if cc:
        _, tlds, site = REGIONS[cc]
        rules.append({"domain": ["domain:" + t for t in tlds]
                      + (["geosite:" + site] if geo and site else []), "outboundTag": "direct"})
        if geo:
            rules.append({"ip": ["geoip:" + cc], "outboundTag": "direct"})
    rules.append(dict({"network": "tcp,udp"}, **target))
    routing = {"domainStrategy": "IPIfNonMatch" if cc and geo else "AsIs", "rules": rules}
    if auto:
        routing["balancers"] = [{"tag": "auto", "selector": ["node-"],
                                 "strategy": {"type": "leastPing"}, "fallbackTag": "node-0"}]
        conf["observatory"] = {"subjectSelector": ["node-"], "probeUrl": PROBE,
                               "probeInterval": "1m", "enableConcurrency": True}

    conf.update({
        "log": {"loglevel": st.get("loglevel", "warning")},
        "stats": {},
        "metrics": {"listen": "127.0.0.1:%d" % METRICS},
        "policy": {"system": {"statsInboundUplink": True, "statsInboundDownlink": True,
                              "statsOutboundUplink": True, "statsOutboundDownlink": True}},
        "inbounds": inbounds,
        "outbounds": outbounds,
        "routing": routing,
    })
    apply_custom(conf, custom)
    if iface:
        # xray's own connections must leave through the physical interface or
        # they loop back into xray0 (SO_BINDTODEVICE, no capability needed).
        for ob in conf["outbounds"]:
            if ob.get("protocol") != "blackhole":
                ob.setdefault("streamSettings", {}).setdefault("sockopt", {}) \
                    .setdefault("interface", iface)
    return conf


def apply_custom(conf, custom):
    """Merge custom.json (see README): rules were placed by build_config;
    here balancers, dns servers, extra in/outbounds and the rest."""
    for key in ("outbounds", "inbounds"):
        extra = custom.get(key)
        if not isinstance(extra, list):
            continue
        for item in extra:
            if not isinstance(item, dict):
                die("custom.json: %s entries must be objects" % key)
            if item.get("tag") in RESERVED_TAGS or str(item.get("tag", "")).startswith("node-"):
                die("custom.json: tag %r is reserved" % item.get("tag"))
            conf[key].append(copy.deepcopy(item))
    croute = custom.get("routing")
    if isinstance(croute, dict):
        if isinstance(croute.get("balancers"), list):
            conf["routing"].setdefault("balancers", []).extend(copy.deepcopy(croute["balancers"]))
        for k, v in croute.items():
            if k not in ("rules", "balancers"):
                conf["routing"][k] = copy.deepcopy(v)
    cdns = custom.get("dns")
    if isinstance(cdns, dict):
        dns = conf.setdefault("dns", {})
        servers = cdns.get("servers")
        if isinstance(servers, list):
            dns["servers"] = copy.deepcopy(servers) + dns.get("servers", [])
        for k, v in cdns.items():
            if k != "servers":
                dns[k] = copy.deepcopy(v)
    rest = {k: v for k, v in custom.items()
            if k not in ("outbounds", "inbounds", "routing", "dns", "proxyPatch", "bootstrapDns")
            and not k.startswith("_")}
    deep_merge(conf, rest)


def write_config(st):
    """Build, validate with the core, then atomically replace config.json.
    A config the core rejects never replaces a working one."""
    if not st["nodes"]:
        die("no nodes — run: omarchy-xray import -")
    conf = build_config(st, load_custom())
    err = xray_test_config(conf)
    if err:
        die("xray rejected the generated config: " + err)
    _cfg_dir()
    atomic_write(CONF, json.dumps(conf, indent=1, ensure_ascii=False), 0o600)


# --- service control ---------------------------------------------------------

def _settle(check, tun, timeout=4.0):
    """Wait until the unit is steadily active; surface the journal otherwise."""
    end = time.time() + timeout
    time.sleep(0.8)
    while time.time() < end:
        if check():
            return True
        time.sleep(0.4)
    tail = _last_lines(journal_tail(tun), n=3)
    die("xray did not start%s" % (": " + tail if tail else " — see: omarchy-xray logs"))


def wanted_mark():
    """Set by `on`, removed by `off`. In the runtime dir, so a new login
    starts with the VPN off: the units are started, never enabled, and the
    widget connects at login only when LOGIN is on."""
    return runtime_dir() / "wanted"


def start_service(st):
    write_user_units()
    uctl("disable", SERVICE, T2S_SERVICE)            # enabled by older versions: no autostart
    tun = st["mode"] == "tun"
    if tun and not tun_installed():
        die(TUN_SETUP_HINT)
    if tun and not T2S:
        die(T2S_HINT)
    if not tun:
        uctl("disable", "--now", T2S_SERVICE)        # its stop deletes the device
    r = uctl("restart" if user_active() else "start", SERVICE)
    if r.returncode != 0:
        die("failed to start %s: %s" % (SERVICE, _last_lines(r.stderr)))
    if tun and uctl("start", T2S_SERVICE, timeout=90).returncode != 0:
        die("TUN did not start: %s. If the polkit rule is missing, re-run: omarchy-xray "
            "tun-setup" % (_last_lines(journal_tail(True), n=3) or "denied"))
    _settle(tun_active if tun else user_active, tun)
    wanted_mark().touch()


def stop_service():
    wanted_mark().unlink(missing_ok=True)          # first: stopping is not a drop
    if T2S_UNIT.exists():
        write_user_units()          # older tun2socks units stopped the root unit unchecked
        uctl("disable", "--now", T2S_SERVICE)        # its stop deletes the device
    ok = uctl("disable", "--now", SERVICE).returncode == 0
    # the device outlived tun2socks (started by hand, or a v3.0 unit): stop
    # the root unit only when it is ours; someone else's is never touched
    loaded, why = tun_unit_check(os.getuid())
    if loaded and not why and sctl("is-active", TUN_SERVICE).stdout.strip() == "active":
        ok = sctl("stop", TUN_SERVICE, timeout=60).returncode == 0 and ok
    return ok


def restart_if_running(st):
    ua, ta = running_units()
    if not (ua or ta):
        return False
    if (st["mode"] == "tun") != ta:
        start_service(st)                          # mode changed under a running unit
    else:                                          # tun2socks needs no restart
        uctl("restart", SERVICE)
        _settle(user_active, False)
    return True


def apply_system_proxy(st, on):
    """Proxy mode: GNOME/GTK proxy settings + session environment (apps that
    Omarchy launches through uwsm inherit the user manager environment).
    TUN mode or off: both cleared. Best-effort — never breaks the tunnel."""
    gs = tool("gsettings")
    on = on and st["mode"] == "proxy"
    if gs:
        if on:
            for scheme, port in (("http", HTTP), ("https", HTTP), ("socks", SOCKS)):
                sh(gs, "set", "org.gnome.system.proxy." + scheme, "host", "127.0.0.1")
                sh(gs, "set", "org.gnome.system.proxy." + scheme, "port", str(port))
            sh(gs, "set", "org.gnome.system.proxy", "mode", "manual")
        else:
            sh(gs, "set", "org.gnome.system.proxy", "mode", "none")
    names = ("http_proxy", "https_proxy", "all_proxy", "no_proxy",
             "HTTP_PROXY", "HTTPS_PROXY", "ALL_PROXY", "NO_PROXY")
    if on:
        hp, sp = "http://127.0.0.1:%d" % HTTP, "socks5h://127.0.0.1:%d" % SOCKS
        np = "localhost,127.0.0.1,::1"
        vals = (hp, hp, sp, np, hp, hp, sp, np)
        uctl("set-environment", *["%s=%s" % kv for kv in zip(names, vals)])
    else:
        uctl("unset-environment", *names)


# --- commands: subscriptions -------------------------------------------------

def secret_url_from_arg(arg):
    """What to import (URL, links or JSON) without argv exposure: `import -`
    reads $OMARCHY_XRAY_SUB_URL first, then stdin (refuses to block on a tty)."""
    if arg == "-" or not arg:
        env = os.environ.get("OMARCHY_XRAY_SUB_URL", "").strip()
        os.environ.pop("OMARCHY_XRAY_SUB_URL", None)
        if env:
            return env
        if arg == "-":
            if sys.stdin.isatty():
                die("usage: OMARCHY_XRAY_SUB_URL=<url> omarchy-xray import -"
                    "  (or pipe the URL on stdin)")
            try:
                data = sys.stdin.read(MAX_PASTE + 1)
            except Exception:
                data = ""
            data = (data or "").strip()
            if data:
                return data
        die("usage: omarchy-xray import -  (with $OMARCHY_XRAY_SUB_URL or stdin)")
    die("refusing a URL in the command line (every local process can read argv): "
        "OMARCHY_XRAY_SUB_URL=<url> omarchy-xray import -")


def rebuild(st, prev_sel, prev_name):
    resolve_selection(st, prev_sel, prev_name)
    save_state(st)
    restarted = False
    if st["nodes"]:
        write_config(st)
        restarted = restart_if_running(st)
    return restarted


def _prev(st):
    n = selected_node(st)
    return st["selected"], (n["name"] if n else "")


def cmd_import(arg):
    _import_text(secret_url_from_arg(arg))


def _import_text(url):
    if len(url) > MAX_PASTE:
        die("too long to import (over %d KiB)" % (MAX_PASTE // 1024))
    if not re.fullmatch(r"https?://\S+", url, re.I):
        return _import_manual(url)
    try:
        check_https_url(url)
    except ValueError as e:
        die(str(e))
    st = load_state()
    new = not any(s.get("url") == url for s in st["subs"])
    if new:
        if len(st["subs"]) >= MAX_SUBS:
            die("too many subscriptions")
        st["subs"].append({"url": url})
    save_state(st)
    prev = _prev(st)
    st["nodes"] = fetch_subs(st)
    sub = next(s for s in st["subs"] if s.get("url") == url)
    if new and sub.get("error"):
        st["subs"].remove(sub)                    # last in the list: no index shifts
    rebuild(st, *prev)
    if sub.get("error"):
        die("%s: %s" % (redact_url(url), sub["error"]))
    if not st["nodes"]:
        die("no nodes fetched for %s — check the URL/network" % redact_url(url))
    out({"ok": True, "subs": len(st["subs"]), "nodes": len(st["nodes"]),
         "skipped": st["skipped"]})


def _import_manual(text):
    """Share links or Xray JSON into the Manual group (one per state). Only
    text with at least one server the core accepts is kept."""
    skipped = {}
    got = core_filter(nodes_from_body(text.encode(), 0, skipped), skipped)
    if not got:
        die("no usable server in the pasted text" + (": " + ", ".join(skipped)[:200] if skipped else ""))
    st = load_state()
    i = next((i for i, s in enumerate(st["subs"]) if "local" in s), None)
    if i is None:
        if len(st["subs"]) >= MAX_SUBS:
            die("too many subscriptions")
        st["subs"].append({"local": [], "title": "Manual"})
        i = len(st["subs"]) - 1
    local = st["subs"][i]["local"]
    if text not in local:
        if sum(map(len, local)) + len(text) > MAX_SUB_BYTES:
            die("the Manual group is full — remove it or use a subscription")
        local.append(text)
    save_state(st)
    prev = _prev(st)
    st["nodes"] = fetch_subs(st, only=i)
    rebuild(st, *prev)
    out({"ok": True, "manual": len(got), "subs": len(st["subs"]), "nodes": len(st["nodes"]),
         "skipped": skipped})


def cmd_subremove(key):
    st = load_state()
    k = str(key or "").strip()
    if k.isdigit():
        if int(k) >= len(st["subs"]):
            die("no subscription with index " + k[:16])
        idx = int(k)
    else:
        kl = k.lower()
        hits = [i for i, s in enumerate(st["subs"])
                if kl and kl in ("manual" if "url" not in s
                                 else urllib.parse.urlsplit(s["url"]).hostname or "").lower()]
        if not hits:
            die("no subscription matches: " + k[:128])
        if len(hits) > 1:
            die("ambiguous — use the numeric index")
        idx = hits[0]
    prev = _prev(st)
    del st["subs"][idx]
    kept = []
    for n in st["nodes"]:                          # re-index, no refetch needed
        if n.get("sub") == idx:
            continue
        if isinstance(n.get("sub"), int) and n["sub"] > idx:
            n["sub"] -= 1
        kept.append(n)
    st["nodes"] = kept
    if st["nodes"]:
        rebuild(st, *prev)
    else:
        st["selected"] = ""
        save_state(st)
        stop_service()
        apply_system_proxy(st, False)
    out({"ok": True, "subs": len(st["subs"]), "nodes": len(st["nodes"])})


def cmd_update(arg=""):
    st = load_state()
    if not st["subs"]:
        die("no subscriptions — run: omarchy-xray import -")
    only = None
    if arg:
        if not arg.isdigit() or int(arg) >= len(st["subs"]):
            die("no subscription with index " + arg[:16])
        only = int(arg)
    prev = _prev(st)
    st["nodes"] = fetch_subs(st, only)
    if not st["nodes"]:
        save_state(st)
        die("no nodes fetched — " + "; ".join(s.get("error", "") for s in st["subs"])[:200])
    rebuild(st, *prev)
    out({"ok": True, "nodes": len(st["nodes"]), "skipped": st["skipped"],
         "selected": st["selected"]})


# --- commands: control -------------------------------------------------------

def resolve_key(st, key):
    k = str(key or "").strip()
    if k == "auto":
        if len(st["nodes"]) < 2:
            die("Auto needs at least two nodes")
        return "auto"
    for n in st["nodes"]:
        if n["id"] == k:
            return k
    if re.match(r"^n\d+$", k) and int(k[1:]) < len(st["nodes"]):
        return st["nodes"][int(k[1:])]["id"]
    low = k.lower()
    if low:
        for n in st["nodes"]:
            if low in n["name"].lower():
                return n["id"]
    die("no node matches: " + k[:128])


def cmd_select(key):
    st = load_state()
    if not st["nodes"]:
        die("no nodes — run: omarchy-xray import -")
    sel = resolve_key(st, key)
    changed = st["selected"] != sel
    st["selected"] = sel
    restarted = False
    if changed:
        write_config(st)
        save_state(st)
        restarted = restart_if_running(st)
    n = selected_node(st)
    out({"ok": True, "selected": sel,
         "name": "Auto" if sel == "auto" else n["name"], "restarted": restarted})


def cmd_on():
    st = load_state()
    if not st["nodes"]:
        die("no nodes — run: omarchy-xray import -")
    if st["selected"] != "auto" and st["selected"] not in {n["id"] for n in st["nodes"]}:
        resolve_selection(st, st["selected"], "")
        save_state(st)
    write_config(st)
    start_service(st)                          # its proxy-sync sets the proxy
    out({"ok": True, "running": True, "mode": st["mode"], "selected": st["selected"]})


def cmd_off():
    st = load_state()
    ok = stop_service()
    apply_system_proxy(st, False)
    out({"ok": ok, "running": any(running_units())})


def cmd_restart():
    st = load_state()
    if not st["nodes"]:
        die("no nodes — run: omarchy-xray import -")
    write_config(st)
    out({"ok": True, "restarted": restart_if_running(st)})


def cmd_mode(mode):
    if mode not in ("proxy", "tun"):
        die("mode must be proxy or tun")
    st = load_state()
    if mode == "tun" and not tun_installed():
        die(TUN_SETUP_HINT)
    was_running = any(running_units())
    st["mode"] = mode
    save_state(st)
    if st["nodes"]:
        write_config(st)
        if was_running:
            start_service(st)                  # its proxy-sync follows the mode
    out({"ok": True, "mode": mode, "running": was_running})


def region_of(routing):
    m = re.match(r"^([a-z]{2})-direct$", routing if isinstance(routing, str) else "")
    return m.group(1) if m and m.group(1) in REGIONS else None


def _apply(st):
    """A setting changed: rebuild the config, save, restart a running tunnel."""
    if st["nodes"]:
        write_config(st)
    save_state(st)
    restart_if_running(st)


def cmd_routing(preset):
    if preset != "global" and not region_of(preset):
        die("routing preset must be global or <region>-direct, region: " + ", ".join(REGIONS))
    st = load_state()
    st["routing"] = preset
    _apply(st)
    out({"ok": True, "routing": preset, "geo": asset_dir() is not None})


def cmd_adblock(value):
    if value not in ("on", "off"):
        die("adblock must be on or off")
    st = load_state()
    st["adblock"] = value == "on"
    if st["adblock"] and asset_dir() is None:
        die("adblock needs geosite.dat — install your distro's Xray geo data "
            "(Arch: v2ray-domain-list-community + v2ray-geoip)")
    _apply(st)
    out({"ok": True, "adblock": st["adblock"]})


def cmd_fragment(args):
    if args[:1] not in (["on"], ["off"]) or len(args) not in (1, 4):
        die("usage: omarchy-xray fragment on|off [packets length interval]")
    st = load_state()
    st["fragment"] = args[0] == "on"
    if len(args) == 4:
        opts = dict(zip(("packets", "length", "interval"), args[1:]))
        for k, v in opts.items():
            if not fragment_opt_ok(k, v):
                die("fragment %s: %r is not valid (%s)" % (k, v[:32], "tlshello or N-M" if k == "packets" else "N or N-M"))
        st["fragmentOpts"] = opts
    _apply(st)
    out({"ok": True, "fragment": st["fragment"], "fragmentOpts": st["fragmentOpts"]})


def cmd_rule(args):
    st = load_state()
    if args[:1] == ["add"] and len(args) == 3 and args[1] in RULE_TARGETS:
        if rule_match(args[2]) is None:
            die("not a domain, IP/CIDR, geosite:… or geoip:…: " + args[2][:64])
        if len(st["rules"]) >= MAX_RULES:
            die("too many rules")
        if args[2].startswith("geo") and asset_dir() is None:
            die("geosite:/geoip: rules need the geo data packages")
        st["rules"].append({"target": args[1], "value": args[2].strip().lower()})
    elif args[:1] == ["rm"] and len(args) == 2 and args[1].isdigit() and int(args[1]) < len(st["rules"]):
        del st["rules"][int(args[1])]
    else:
        die("usage: omarchy-xray rule add <direct|proxy|block> <value> | rule rm <index>")
    _apply(st)
    out({"ok": True, "rules": st["rules"]})


def cmd_fav(key):
    st = load_state()
    k = resolve_key(st, key)
    if k == "auto":
        die("Auto cannot be starred")
    favs = st["favorites"]
    if k in favs:
        favs.remove(k)
    elif len(favs) >= MAX_FAVS:
        die("too many starred nodes")
    else:
        favs.append(k)
    if st.get("autoFavorites") and st["selected"] == "auto":
        _apply(st)                       # the Auto members changed
    else:
        save_state(st)
    out({"ok": True, "starred": k in favs})


def cmd_set(key, value):
    st = load_state()
    onoff = {"on": True, "off": False}
    if key in ("autofav", "lan") and value in onoff:
        st["autoFavorites" if key == "autofav" else "lan"] = onoff[value]
    elif key == "mux" and (value in onoff or (value.isdigit() and 1 <= int(value) <= 1024)):
        st["mux"] = onoff.get(value, True)
        if value.isdigit():
            st["muxConcurrency"] = int(value)
    elif key == "subupdate" and (value in ("auto", "off") or (value.isdigit() and 1 <= int(value) <= 168)):
        st["subUpdate"] = {"auto": None, "off": 0}.get(value, int(value) if value.isdigit() else None)
        if st["subUpdate"] is None:
            st.pop("subUpdate")
        save_state(st)                       # the widget's timer reads it from status
        out({"ok": True, "subUpdate": st.get("subUpdate")})
        return
    elif key == "geoupdate" and (value == "off" or (value.isdigit() and 1 <= int(value) <= 90)):
        st["geoDays"] = 0 if value == "off" else int(value)
        save_state(st)                       # the widget's timer reads it from status
        out({"ok": True, "geoDays": st["geoDays"]})
        return
    elif key == "loglevel" and value in LOGLEVELS:
        st["loglevel"] = value
    elif key == "ua" and (value == "default" or ua_ok(value)):
        if value == "default":
            st.pop("userAgent", None)
        else:
            st["userAgent"] = value
        save_state(st)                       # used at the next download
        out({"ok": True, "ua": st.get("userAgent", "")})
        return
    else:
        die("usage: omarchy-xray set autofav|lan on|off · mux on|off|<1-1024> · loglevel "
            + "|".join(LOGLEVELS) + " · ua <text|default> · subupdate auto|off|<1-168 hours> · geoupdate off|<1-90 days>")
    _apply(st)
    out({"ok": True, key: value})


def cmd_chain(key):
    st = load_state()
    if key == "off":
        st["chain"] = ""
    else:
        k = resolve_key(st, key)
        if k == "auto":
            die("the first hop must be one node")
        st["chain"] = k
    _apply(st)
    n = next((n for n in st["nodes"] if n["id"] == st["chain"]), None)
    out({"ok": True, "chain": st["chain"], "chainName": n["name"] if n else ""})


def clip_copy(text):
    """Into the Wayland clipboard via stdin: a secret never goes through argv."""
    wl = tool("wl-copy")
    if not wl:
        die("copying needs wl-clipboard")
    try:
        subprocess.run([wl], input=text, text=True, timeout=10, env=child_env(
            {k: os.environ[k] for k in ("WAYLAND_DISPLAY", "XDG_RUNTIME_DIR") if k in os.environ}),
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=True)
    except (subprocess.SubprocessError, OSError):
        die("wl-copy failed")


def cmd_share(key, qr=""):
    """The node's link (secret: it carries the credentials) and, with qr, a
    PNG in the private runtime dir for the widget to show."""
    st = load_state()
    k = resolve_key(st, key)
    n = next((n for n in st["nodes"] if n["id"] == k), None)
    if n is None:
        die("Auto has no link of its own")
    text = n.get("link") or json.dumps(dict(n["ob"], tag="proxy"), ensure_ascii=False)
    res = {"ok": True, "name": n["name"], "link": text, "kind": "link" if n.get("link") else "json"}
    if qr == "copy":
        clip_copy(text)
        res.pop("link")                  # in the clipboard, not in the widget's logs
    if qr == "qr":
        png = runtime_dir() / "share.png"
        qrenc = tool("qrencode")
        if not qrenc:
            die("QR needs qrencode (omarchy pkg add qrencode)")
        r = subprocess.run([qrenc, "-o", str(png), "-s", "6", "-m", "2", "-r", "/dev/stdin"],
                           input=text, text=True, capture_output=True, timeout=10, env=child_env())
        if r.returncode != 0:
            die("qrencode failed: " + _last_lines(r.stderr, 1, 120))
        os.chmod(png, 0o600)
        res["png"] = str(png)
    out(res)


def _wayland_env():
    return child_env({k: os.environ[k] for k in ("WAYLAND_DISPLAY", "XDG_RUNTIME_DIR") if k in os.environ})


def cmd_scan():
    """A QR code from the screen (a region you drag) into import: a
    subscription URL or share links. The text never touches argv or disk."""
    grim, slurp, zbar = tool("grim"), tool("slurp"), tool("zbarimg")
    if not (grim and slurp and zbar):
        die("scanning needs grim, slurp and zbar (omarchy pkg add zbar)")
    env = _wayland_env()
    g = subprocess.run([slurp], capture_output=True, text=True, timeout=120, env=env)
    geom = g.stdout.strip()
    if g.returncode != 0 or not re.fullmatch(r"-?\d+,-?\d+ \d+x\d+", geom):
        die("no region selected")
    shot = subprocess.run([grim, "-g", geom, "-t", "png", "-"], capture_output=True, timeout=30, env=env)
    if shot.returncode != 0 or not shot.stdout:
        die("screenshot failed")
    z = subprocess.run([zbar, "--raw", "-q", "-Sdisable", "-Sqrcode.enable", "-"],
                       input=shot.stdout, capture_output=True, timeout=30, env=env)
    text = z.stdout.decode("utf-8", "replace").strip()[:MAX_PASTE + 1]
    if z.returncode != 0 or not text:
        die("no QR code found in the selected region")
    _import_text(text)


def _speed_curl(port):
    """Mbit/s through a local SOCKS port (25 MB, 15 s at most); None if under 1 MB came."""
    r = sh(CURL, "-s", "-o", "/dev/null", "--max-time", "15", "-w", "%{speed_download} %{size_download}",
           "--socks5-hostname", "127.0.0.1:%d" % port, SPEED_URL, timeout=20)
    try:
        bps, size = (float(x) for x in (r.stdout or "").split()[:2])
    except ValueError:
        return None
    return round(bps * 8 / 1e6, 1) if size >= 1000000 else None


def cmd_speed(key=""):
    """Download speed: the running tunnel, or one node through a throwaway
    core (as the latency test: bound to the physical link while TUN is up)."""
    st = load_state()
    running = running_units()[0]
    k = resolve_key(st, key) if key else ""
    if k == "auto":
        die("pick one node: Auto has no speed of its own")
    if not k or (running and k == st["selected"]):
        if not running:
            die("not connected — pick a node to test it on its own")
        mbps = _speed_curl(SOCKS)
        k = st["selected"]
    else:
        n = next(n for n in st["nodes"] if n["id"] == k)
        res = _probe_batch([n], default_dev() if tun_active() else None, runtime_dir(), probe=_speed_curl)
        mbps = res[0] if res else None
    if mbps is None:
        die("speed test failed")
    if k and k != "auto":
        sp = {kk: v for kk, v in load_json(SPEED, {}).items() if any(n["id"] == kk for n in st["nodes"])}
        sp[k] = mbps
        _cfg_dir()
        atomic_write(SPEED, json.dumps(sp), 0o600)
    out({"ok": True, "mbps": mbps, "key": k})


def geo_due(st):
    """A downloaded set older than its interval (never the distro's own files)."""
    days = st.get("geoDays", GEO_DAYS)
    if not days:
        return False
    try:
        return time.time() - (GEO_DIR / "geosite.dat").stat().st_mtime > days * 86400
    except OSError:
        return False


def cmd_geo(verb):
    """geo update: fresh geoip.dat + geosite.dat (Loyalsoldier), checked
    against the release's sha256 files, swapped in whole."""
    if verb != "update":
        die("usage: omarchy-xray geo update")
    via = user_active()
    _cfg_dir()
    GEO_DIR.mkdir(mode=0o700, exist_ok=True)
    got = {}
    for name in ("geoip.dat", "geosite.dat"):
        try:
            body, _ = fetch(GEO_URL + name, via, cap=GEO_MAX_BYTES)
            want, _ = fetch(GEO_URL + name + ".sha256sum", via, cap=4096)
        except (ValueError, RuntimeError) as e:
            die("%s: %s" % (name, e))
        if hashlib.sha256(body).hexdigest() != (want.decode("ascii", "replace").split() or [""])[0]:
            die(name + ": checksum mismatch — refused")
        got[name] = body
    for name, body in got.items():
        tmp = GEO_DIR / (name + ".tmp")
        with open(tmp, "wb") as f:
            f.write(body)
        os.chmod(tmp, 0o644)
        os.replace(tmp, GEO_DIR / name)
    st = load_state()
    write_user_units()                       # XRAY_LOCATION_ASSET may point here now
    _apply(st)
    out({"ok": True, "geo": str(GEO_DIR), "bytes": sum(map(len, got.values()))})


def cmd_whoami():
    """Exit IP and country through the tunnel (Cloudflare's trace page)."""
    if not running_units()[0]:
        die("not connected")
    r = sh(CURL, "-s", "--max-time", "8", "--socks5-hostname", "127.0.0.1:%d" % SOCKS,
           "https://cloudflare.com/cdn-cgi/trace", timeout=12)
    info = dict(l.split("=", 1) for l in (r.stdout or "").splitlines()[:40] if "=" in l)
    ip, loc = info.get("ip", ""), info.get("loc", "")
    if not (is_ip(ip) and re.fullmatch(r"[A-Z]{2}", loc or "XX")):
        die("could not reach the exit check through the tunnel")
    out({"ok": True, "ip": ip, "country": loc})


SETTINGS_KEYS = ("userAgent", "subUpdate", "geoDays", "routing", "adblock", "dns", "dnsCustom", "fragment", "fragmentOpts", "rules",
                 "favorites", "autoFavorites", "mux", "muxConcurrency", "loglevel")


def cmd_settings(verb):
    st = load_state()
    exported = dict({"omarchyXraySettings": 1}, **{k: st[k] for k in SETTINGS_KEYS if k in st})
    if verb == "export":
        out(exported)
        return
    if verb == "copy":
        clip_copy(json.dumps(exported, indent=1, ensure_ascii=False))
        out({"ok": True, "copied": True})
        return
    if verb == "paste":
        wl = tool("wl-paste")
        r = subprocess.run([wl, "-n"], capture_output=True, text=True, timeout=10, env=child_env(
            {k: os.environ[k] for k in ("WAYLAND_DISPLAY", "XDG_RUNTIME_DIR") if k in os.environ})) if wl else None
        raw = (r.stdout if r and r.returncode == 0 else "")[:262144]
    elif verb != "import" or sys.stdin.isatty():
        die("usage: omarchy-xray settings export|copy | import - (JSON on stdin)|paste")
    else:
        raw = sys.stdin.read(262144)
    try:
        data = json.loads(raw)
    except ValueError:
        die("settings import: not JSON")
    if not isinstance(data, dict) or data.get("omarchyXraySettings") != 1:
        die("settings import: not an omarchy-xray settings export")
    st.update({k: data[k] for k in SETTINGS_KEYS if k in data})
    save_state(st)
    st = load_state()                   # the same checks as any state read
    _apply(st)
    out({"ok": True, "imported": [k for k in SETTINGS_KEYS if k in data]})


def cmd_dns(name, addr=""):
    if name not in DNS_PRESETS:
        die("dns must be one of: " + ", ".join(DNS_PRESETS))
    st = load_state()
    if name == "custom":
        addr = addr.strip() or st.get("dnsCustom", "")
        if not dns_custom_ok(addr):
            die("custom DNS: an IP, or %s://host[:port][/path]" % "|".join(DNS_SCHEMES))
        st["dnsCustom"] = addr
    st["dns"] = name
    if st["mode"] == "tun":
        _apply(st)
    else:
        save_state(st)                          # used once TUN is on
    out({"ok": True, "dns": name})


# --- latency test ------------------------------------------------------------

_PROCS = set()


def _kill_all():
    for p in list(_PROCS):
        try:
            os.killpg(p.pid, signal.SIGKILL)
        except Exception:
            try:
                p.kill()
            except Exception:
                pass


_STOP = []


def _on_term(signum, frame):
    # Stop (widget SIGTERM / Ctrl-C): kill the probes, drop the in-flight
    # batch, keep and save what already finished.
    _STOP.append(signum)
    _kill_all()


def _free_ports(n):
    socks_, ports = [], []
    try:
        for _ in range(n):
            s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            s.bind(("127.0.0.1", 0))
            socks_.append(s)
            ports.append(s.getsockname()[1])
    finally:
        for s in socks_:
            s.close()
    return ports


def _wait_ports(ports, proc, timeout):
    end = time.time() + timeout
    pending = set(ports)
    while pending and time.time() < end:
        if proc.poll() is not None:
            return False
        for p in list(pending):
            try:
                with socket.create_connection(("127.0.0.1", p), timeout=0.2):
                    pending.discard(p)
            except OSError:
                pass
        if pending:
            time.sleep(0.05)
    return not pending


def _curl(port):
    r = sh(CURL, "-s", "-o", "/dev/null", "-w", "%{http_code} %{time_total}",
           "--socks5-hostname", "127.0.0.1:%d" % port, "--max-time", "8", PROBE,
           timeout=15)
    code, _, secs = (r.stdout or "").strip().partition(" ")
    if code in ("200", "204"):
        try:
            return "%dms" % round(float(secs) * 1000)
        except ValueError:
            pass
    return "timeout"


def _probe_batch(batch, iface, rundir, probe=None):
    ports = _free_ports(len(batch))
    conf = {"log": {"loglevel": "none"}, "inbounds": [], "outbounds": [],
            "routing": {"rules": []}}
    for i, (n, port) in enumerate(zip(batch, ports)):
        conf["inbounds"].append({"tag": "t%d" % i, "listen": "127.0.0.1", "port": port,
                                 "protocol": "socks", "settings": {"auth": "noauth"}})
        conf["outbounds"].append(node_outbound(n, "o%d" % i, "proxy", iface=iface))
        conf["routing"]["rules"].append({"inboundTag": ["t%d" % i], "outboundTag": "o%d" % i})
    path = rundir / ("probe-%d.json" % os.getpid())
    atomic_write(path, json.dumps(conf), 0o600)
    proc = subprocess.Popen([XRAY, "run", "-c", str(path)], stdout=subprocess.DEVNULL,
                            stderr=subprocess.DEVNULL, stdin=subprocess.DEVNULL,
                            start_new_session=True, env=child_env())
    _PROCS.add(proc)
    try:
        if not _wait_ports(ports, proc, 6.0):
            return None
        from concurrent.futures import ThreadPoolExecutor
        with ThreadPoolExecutor(max_workers=min(TEST_PARALLEL, len(ports))) as ex:
            return list(ex.map(probe or _curl, ports))
    finally:
        try:
            os.killpg(proc.pid, signal.SIGTERM)
            proc.wait(timeout=3)
        except Exception:
            try:
                os.killpg(proc.pid, signal.SIGKILL)
                proc.wait(timeout=3)
            except Exception:
                pass
        _PROCS.discard(proc)
        try:
            path.unlink()
        except OSError:
            pass


def cmd_test(keys):
    st = load_state()
    if not st["nodes"]:
        die("no nodes")
    if not os.path.isfile(CURL):
        die("curl is required for latency tests")
    if keys:
        wanted = set(keys)
        nodes = [n for n in st["nodes"] if n["id"] in wanted][:MAX_TEST_NODES]
        if not nodes:
            die("no node matches the given keys")
    else:
        nodes = st["nodes"][:MAX_TEST_NODES]
        if len(st["nodes"]) > MAX_TEST_NODES:
            print("warn: testing first %d of %d nodes" % (MAX_TEST_NODES, len(st["nodes"])),
                  file=sys.stderr)
    # With the TUN up, bind probes to the physical link so they do not ride the
    # active tunnel (unprivileged SO_BINDTODEVICE, Linux >= 5.7).
    iface = default_dev() if tun_active() else None
    rundir = runtime_dir()
    lat = load_json(LAT, {})
    ids = {n["id"] for n in st["nodes"]}
    lat = {k: v for k, v in lat.items() if k in ids}
    deadline = time.time() + TEST_DEADLINE_SEC
    old = (signal.getsignal(signal.SIGTERM), signal.getsignal(signal.SIGINT))
    signal.signal(signal.SIGTERM, _on_term)
    signal.signal(signal.SIGINT, _on_term)
    try:
        queue = [nodes[i:i + TEST_BATCH] for i in range(0, len(nodes), TEST_BATCH)]
        while queue and not _STOP:
            if time.time() > deadline:
                print("warn: test deadline reached — rest skipped", file=sys.stderr)
                break
            batch = queue.pop(0)
            res = _probe_batch(batch, iface, rundir)
            if _STOP:
                break
            if res is None:
                if len(batch) > 1:                 # isolate the node xray refused
                    queue = [[n] for n in batch] + queue
                    continue
                res = ["error"]
            for n, r in zip(batch, res):
                lat[n["id"]] = r
                print("%-32s %s" % (n["name"][:32], r), file=sys.stderr)
            _cfg_dir()
            atomic_write(LAT, json.dumps({k: str(v)[:32] for k, v in lat.items()}), 0o600)
    finally:
        signal.signal(signal.SIGTERM, old[0])
        signal.signal(signal.SIGINT, old[1])
        _kill_all()
    out({"ok": True, "latency": lat, "stopped": bool(_STOP)})


# --- status ----------------------------------------------------------

def addr_label(host, port):
    return ("[%s]:%d" if ":" in host else "%s:%d") % (host, port)


def net_label(n):
    if n["proto"] == "hysteria":
        return "hysteria2"
    parts = [n["proto"]]
    if n.get("sec") and n["sec"] != "none":
        parts.append(n["sec"])
    parts.append(n.get("net") or "raw")
    return "/".join(parts)[:64]


def unit_states():
    """ActiveState / SubState / NRestarts of both user units in one
    systemctl call."""
    r = uctl("show", "-p", "Id", "-p", "ActiveState", "-p", "SubState", "-p", "NRestarts",
             SERVICE, T2S_SERVICE)
    units, cur = {}, {}
    for line in (r.stdout or "").splitlines() + [""]:
        if not line.strip():
            if cur.get("Id"):
                units[cur["Id"]] = cur
            cur = {}
            continue
        k, _, v = line.partition("=")
        cur[k] = v
    return units


def cmd_status():
    st = load_state()
    mark = runtime_dir() / "session-started"
    session_start = not mark.exists()
    if session_start:
        mark.touch()
        if not any(running_units()):
            # left on at logout: the proxy settings (dconf) outlive the session
            apply_system_proxy(st, False)
    lat = load_json(LAT, {})
    speeds = load_json(SPEED, {})
    us = unit_states()
    xs, ts = us.get(SERVICE, {}), us.get(T2S_SERVICE, {})
    tun_mode = st["mode"] == "tun"
    running = xs.get("ActiveState") == "active" and (not tun_mode or ts.get("ActiveState") == "active")
    wanted = wanted_mark().exists()                        # off removes it; a crash does not
    relevant = [xs, ts] if tun_mode else [xs]
    # A crash, not an off: a unit waits to restart (or gave up) while wanted.
    # In TUN the kill switch keeps the device, so traffic is blocked meanwhile.
    dropped = wanted and not running and any(u.get("SubState") in ("auto-restart", "failed")
                                             for u in relevant)
    blocked = dropped and tun_mode and sctl("is-active", TUN_SERVICE).stdout.strip() == "active"
    restarts = sum(int(u["NRestarts"]) for u in relevant if u.get("NRestarts", "").isdigit())
    now = int(time.time())
    nodes = []
    auto_tags = []
    favs = set(st["favorites"])
    if len(st["nodes"]) > 1:
        members = auto_members(st)
        nodes.append({"key": "auto", "name": "Auto — best ping",
                      "address": "%d nodes" % len(members), "net": "balancer",
                      "latency": "", "sub": -1})
        if st["selected"] == "auto":
            auto_tags = [{"tag": "node-%d" % i, "key": n["id"]} for i, n in enumerate(members)]
    for n in st["nodes"]:
        nodes.append({"key": n["id"], "name": n["name"][:MAX_STR],
                      "address": addr_label(n["host"][:253], n["port"]),
                      "net": net_label(n), "latency": str(lat.get(n["id"], ""))[:32],
                      "sub": n.get("sub", 0), "fav": n["id"] in favs,
                      "speed": speeds.get(n["id"]) if isinstance(speeds.get(n["id"]), (int, float)) else None})
    subs, due = [], False
    for i, s in enumerate(st["subs"]):
        interval = st.get("subUpdate") or s.get("interval") or DEFAULT_UPDATE_HOURS
        fetched = int(s.get("fetched") or 0)
        local = "url" not in s                     # the Manual group: nothing to download
        if fetched and not local and st.get("subUpdate") != 0 and now - fetched > interval * 3600:
            due = True
        subs.append({"index": i, "local": local,
                     "host": "manual" if local else urllib.parse.urlsplit(s["url"]).hostname or "subscription",
                     "url": "" if local else redact_url(s["url"]), "title": s.get("title", ""),
                     "info": s.get("info", {}), "fetched": fetched,
                     "error": s.get("error", "")})
    sel = st["selected"]
    if sel != "auto" or len(st["nodes"]) < 2:
        n = selected_node(st)
        sel = n["id"] if n else ""
    last_error = ""
    if not running and any(u.get("ActiveState") == "failed" for u in relevant):
        last_error = _last_lines(journal_tail(tun_mode), n=2, cap=240)
    out({
        "ok": True,
        "running": running,
        "mode": st["mode"],
        "routing": st["routing"],
        "regions": [{"code": c, "name": v[0],
                     "flag": "".join(chr(0x1F1E6 + ord(ch) - 97) for ch in c)}
                    for c, v in REGIONS.items()],
        "adblock": st["adblock"],
        "fragment": st["fragment"],
        "fragmentOpts": st["fragmentOpts"],
        "rules": st["rules"],
        "favorites": len(st["favorites"]),
        "autoFavorites": st["autoFavorites"],
        "mux": st["mux"],
        "muxConcurrency": st["muxConcurrency"],
        "loglevel": st["loglevel"],
        "userAgent": st.get("userAgent", ""),
        "chain": st["chain"],
        "chainName": next((n["name"][:MAX_STR] for n in st["nodes"] if n["id"] == st["chain"]), ""),
        "lan": st["lan"],
        # the LAN password is for the user to type into a phone: shown, never logged
        "lanInfo": {"ip": lan_ip(), "socks": LAN_SOCKS, "http": LAN_HTTP,
                    "user": st["lanAuth"]["user"], "pass": st["lanAuth"]["pass"]} if st["lan"] else None,
        "dns": st["dns"],
        "dnsCustom": st.get("dnsCustom", ""),
        "geo": asset_dir() is not None,
        "geoOwn": (GEO_DIR / "geosite.dat").exists(),
        "geoDue": geo_due(st),
        "geoDays": st.get("geoDays", GEO_DAYS),
        "subUpdate": st.get("subUpdate", -1),          # -1: the provider's interval (or 24 h)
        "xray": os.path.isfile(XRAY),
        "tunInstalled": tun_installed(),
        # off clears it; a crash leaves it set - that is a drop
        "dropped": dropped,
        "blocked": blocked,
        "restarts": restarts,
        "sessionStart": session_start,          # the widget's connect-at-login
        "subs": subs,
        "skipped": st["skipped"],
        "updateDue": due and bool(st["subs"]),
        "selected": sel,
        "connectedKey": sel if running else "",
        "autoMembers": auto_tags,
        "lastError": last_error,
        "nodes": nodes,
    })


def cmd_logs(n="40"):
    st = load_state()
    try:
        count = max(1, min(500, int(n)))
    except ValueError:
        count = 40
    text = journal_tail(st["mode"] == "tun", count)
    if sys.stdout.isatty():
        print(text or "(no journal lines)")
    else:
        out({"ok": True, "lines": text.splitlines()})


# --- doctor ------------------------------------------------------------------

def _polkit_agent_running():
    for pid in os.listdir("/proc"):
        if not pid.isdigit():
            continue
        try:
            cmd = pathlib.Path("/proc", pid, "cmdline").read_bytes()[:512].decode("utf-8", "replace")
        except OSError:
            continue
        low = cmd.lower()
        if "polkit" in low and ("agent" in low or "authentication" in low):
            return True
        # the Omarchy shell ships its own agent (plugins/polkit, keepLoaded)
        if "quickshell" in low and OMARCHY_SHELL in low and OMARCHY_POLKIT.is_file():
            return True
    return False


def cmd_doctor():
    checks = []

    def add(name, ok, detail=""):
        checks.append({"check": name, "ok": bool(ok), "detail": detail})

    have = os.path.isfile(XRAY)
    ver = _last_lines(sh(XRAY, "version", timeout=10).stdout, n=1, cap=80) if have else ""
    add("xray core", have, ver or XRAY)
    cv = core_version()
    add("core >= %s (all transports)" % ver_str(MIN_CORE), cv is None or cv >= MIN_CORE,
        ver_str(cv) + ("" if cv is None or cv >= MIN_CORE else
                       " — mKCP/Hysteria2 nodes may be rejected; update xray"))
    add("tun2socks (TUN mode)", T2S, T2S or "missing: omarchy pkg aur add tun2socks")
    a = asset_dir()
    add("geo files (geoip.dat/geosite.dat)", a, a or "missing: routing presets use built-in lists only")
    add("curl", os.path.isfile(CURL), CURL)
    add("/dev/net/tun", os.path.exists("/dev/net/tun"))
    rel = os.uname().release
    m = re.match(r"(\d+)\.(\d+)", rel)
    add("kernel >= 5.7 (unprivileged SO_BINDTODEVICE)",
        m and (int(m.group(1)), int(m.group(2))) >= (5, 7), rel)
    add("TUN system unit installed", tun_installed(),
        str(SYS_UNIT) if tun_installed() or not SYS_UNIT.is_file()
        else "from v3.0 (xray with CAP_NET_ADMIN) — run: omarchy-xray tun-setup")
    add("polkit agent running", _polkit_agent_running(), "needed for the one-time tun-setup prompt")
    resolved = sctl("is-active", "systemd-resolved").stdout.strip() == "active"
    add("systemd-resolved (DNS through the TUN)", resolved)
    networkd = sctl("is-active", "systemd-networkd").stdout.strip() == "active"
    add("networkd ignores xray0", not networkd or NETWORKD_FILE.is_file(),
        "networkd active" if networkd else "networkd not used")
    ua, ta = running_units()
    add("service running", ua or ta, "tun" if ta else ("proxy" if ua else "stopped"))
    add("default route", default_dev() is not None, default_dev() or "none")
    if sys.stdout.isatty():
        for c in checks:
            print("%s %-44s %s" % ("✓" if c["ok"] else "✗", c["check"], c["detail"]))
    else:
        out({"ok": True, "checks": checks})


# --- TUN setup (the only privileged code path) -------------------------------

def tun_unit_text(uid, ip, udevadm, resolvectl):
    t, tab, p = TUN_NAME, TUN_TABLE, TUN_PREF
    # The default route into the device lives in its own table, used only by
    # lookups with no source yet or from the device's address. xray's sockets
    # (bound to the physical link) and the strict rp_filter check of their
    # replies look up from the physical address, so they keep using main.
    # (IPv6 picks the source from the device before matching a `from` rule,
    # so its own address covers unset sources; IPv4 needs 0.0.0.0/32.)
    # Ownership: xray0 carries the alias TUN_MARK and only a device with it
    # is ever deleted; rules are deleted by their full spec (pref + selector
    # + table), so a neighbour's device or rule is never touched. A foreign
    # xray0 stops the start (preflight) instead of being replaced.
    ours = "%s link show dev %s 2>/dev/null | grep -q 'alias %s'" % (ip, t, TUN_MARK)
    clean = ['-/bin/sh -c "%s && exec %s link delete %s"' % (ours, ip, t)]
    rules = []
    for fam, opt, sel in (("", "", ["from 0.0.0.0/32", "from " + TUN_GW4.split("/")[0]]),
                          ("-6 ", "-", ["from " + TUN_GW6.split("/")[0]])):
        specs = ["lookup main suppress_prefixlength 0"] + ["%s lookup %d" % (x, tab) for x in sel]
        rules += ["%s%s %sroute add default dev %s table %d" % (opt, ip, fam, t, tab)]
        rules += ["%s%s %srule add pref %d %s" % (opt, ip, fam, p + i, x) for i, x in enumerate(specs)]
        clean += ["-%s %srule delete pref %d %s" % (ip, fam, p + i, x) for i, x in enumerate(specs)]
    preflight = ['/bin/sh -c "if %s link show dev %s >/dev/null 2>&1; then '
                 'echo \'%s exists and is not ours - refusing\' >&2; exit 1; fi"' % (ip, t, t)]
    wait = ["-%s wait --timeout=15 /sys/class/net/%s" % (udevadm, t)] if udevadm else []
    dns = ["-%s dns %s %s" % (resolvectl, t, TUN_DNS), "-%s domain %s ~." % (resolvectl, t),
           "-%s default-route %s yes" % (resolvectl, t),
           "-%s dnsovertls %s no" % (resolvectl, t)] if resolvectl else []
    up = ["%s tuntap add dev %s mode tun user %d" % (ip, t, int(uid)),
          "%s link set dev %s alias %s" % (ip, t, TUN_MARK),
          "%s address add %s dev %s" % (ip, TUN_GW4, t),
          "-%s -6 address add %s dev %s nodad" % (ip, TUN_GW6, t),
          "%s link set dev %s mtu 1500 up" % (ip, t)] + rules + wait + dns
    lines = lambda key, cmds: "".join("%s=%s\n" % (key, c) for c in cmds)
    return (
        "# Installed by `omarchy-xray tun-setup` (%s). Remove: omarchy-xray tun-remove\n"
        "%s\n"
        "# Root runs only ip, udevadm and resolvectl: %s is created for uid %d,\n"
        "# all traffic is routed into it and DNS pointed at it. tun2socks and xray\n"
        "# run as that user without capabilities. Stopping deletes the device.\n"
        "[Unit]\n"
        "Description=omarchy-xray TUN device for uid %d\n"
        "After=network-online.target systemd-resolved.service\n\n"
        "[Service]\n"
        "Type=oneshot\n"
        "RemainAfterExit=yes\n"
        "%s%s%s"
        "CapabilityBoundingSet=CAP_NET_ADMIN\n"
        "NoNewPrivileges=yes\n"
        "ProtectSystem=strict\n"
        "ProtectHome=yes\n"
        "PrivateTmp=yes\n"
        "ProtectKernelTunables=yes\n"
        "ProtectKernelModules=yes\n"
        "ProtectKernelLogs=yes\n"
        "ProtectControlGroups=yes\n"
        "ProtectHostname=yes\n"
        "RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6\n"
        "RestrictNamespaces=yes\n"
        "RestrictRealtime=yes\n"
        "RestrictSUIDSGID=yes\n"
        "LockPersonality=yes\n"
        "SystemCallArchitectures=native\n"
    ) % (VERSION, TUN_LAYOUT, t, int(uid), int(uid),
         lines("ExecStartPre", clean + preflight), lines("ExecStart", up), lines("ExecStopPost", clean))


def polkit_rule_text(user):
    return (
        "// Installed by `omarchy-xray tun-setup`. Lets %(u)s start, stop and\n"
        "// restart exactly %(unit)s without a password — nothing else.\n"
        "polkit.addRule(function (action, subject) {\n"
        "    if (action.id === \"org.freedesktop.systemd1.manage-units\" &&\n"
        "        subject.user === \"%(u)s\" &&\n"
        "        action.lookup(\"unit\") === \"%(unit)s\") {\n"
        "        var verb = action.lookup(\"verb\");\n"
        "        if (verb === \"start\" || verb === \"stop\" || verb === \"restart\") {\n"
        "            return polkit.Result.YES;\n"
        "        }\n"
        "    }\n"
        "});\n") % {"u": user, "unit": TUN_SERVICE}


NETWORKD_TEXT = """# Installed by `omarchy-xray tun-setup`: omarchy-xray-tun.service configures
# %s itself, systemd-networkd must leave it alone.
[Match]
Name=%s

[Link]
Unmanaged=yes
""" % (TUN_NAME, TUN_NAME)


def _invoking_user():
    raw = os.environ.get("PKEXEC_UID") or os.environ.get("SUDO_UID") or ""
    if not raw.isdigit() or int(raw) == 0:
        die("run this through `omarchy-xray tun-setup` (pkexec) or sudo from your user account")
    try:
        pw = pwd.getpwuid(int(raw))
    except KeyError:
        die("unknown invoking user")
    if not _USER_RE.match(pw.pw_name):
        die("unsupported user name for a systemd unit: %r" % pw.pw_name)
    return pw


def _root_write(path, text):
    path.parent.mkdir(parents=True, exist_ok=True)
    atomic_write(path, text, 0o644)
    os.chown(path, ROOT, ROOT)


def _root_write_all(pairs):
    """Write every (path, text) or none: on any failure put back what was
    there before (or remove what did not exist) and stop."""
    before = {}
    try:
        for path, text in pairs:
            before[path] = path.read_text() if path.is_file() else None
            _root_write(path, text)
    except OSError as e:
        for path, old in before.items():
            try:
                if old is None:
                    path.unlink()
                else:
                    _root_write(path, old)
            except OSError:
                pass
        die("TUN setup failed writing %s (%s) — previous state restored" % (path, e.strerror or e))


def _sha(text):
    return hashlib.sha256(text.encode()).hexdigest()


def _tun_record():
    """{"uid", "user", "files": {path: sha256}} from the last tun-install, or
    {} when there is none. Only a root-owned regular file counts."""
    try:
        text = read_nofollow(TUN_RECORD, 65536)
        if text is None or os.lstat(TUN_RECORD).st_uid != ROOT:
            return {}
        rec = json.loads(text)
    except (ValueError, OSError):
        return {}
    ok = isinstance(rec, dict) and isinstance(rec.get("uid"), int) and isinstance(rec.get("files"), dict)
    return rec if ok else {}


def _managed(pw):
    """(path, text) of every file tun-install writes for this user; the unit
    is None when a system tool is missing (it cannot be generated)."""
    ip, udevadm, resolvectl = tool("ip"), tool("udevadm"), tool("resolvectl")
    unit = tun_unit_text(pw.pw_uid, ip, udevadm, resolvectl) if ip else None
    return [(SYS_UNIT, unit), (POLKIT_RULE, polkit_rule_text(pw.pw_name)), (NETWORKD_FILE, NETWORKD_TEXT)]


def _ours(path, text, rec, uid):
    """May root replace or delete `path`? Only when it is absent, byte-for-byte
    what tun-install writes for this user, or exactly what the record says we
    wrote for this user. A link, a changed file or another user's is foreign."""
    try:
        cur = read_nofollow(path, 1024 * 1024)
    except ValueError:
        return False
    if cur is None:
        return True
    if text is not None and cur == text:
        return True
    return rec.get("uid") == uid and rec["files"].get(str(path)) == _sha(cur)


def _foreign(pw, paths):
    """Paths among `paths` that are not ours, after refusing another user's setup."""
    rec = _tun_record()
    if rec and rec["uid"] != pw.pw_uid:
        die("TUN mode is set up for another user (%s) — run tun-remove as that user first; nothing was changed"
            % str(rec.get("user") or rec["uid"])[:32])
    return rec, [str(p) for p, t in _managed(pw) if p in paths and not _ours(p, t, rec, pw.pw_uid)]


def _loaded_tun_unit():
    """(loaded, why_foreign) for what systemd has loaded as TUN_SERVICE. Ours
    only when loaded from SYS_UNIT itself with no drop-ins: a unit of that name
    from another directory, a transient, masked or broken one, or one with
    drop-ins is someone else's and is never stopped. Nothing loaded and
    nothing running is (False, None)."""
    r = sh(SYSTEMCTL, "show", "--property=LoadState,ActiveState,FragmentPath,DropInPaths,NeedDaemonReload",
           TUN_SERVICE)
    if r.returncode != 0:
        return True, "systemctl show failed: %s" % _last_lines(r.stderr, n=1)
    p = dict(line.split("=", 1) for line in r.stdout.splitlines() if "=" in line)
    load, frag, drop = p.get("LoadState", ""), p.get("FragmentPath", ""), p.get("DropInPaths", "").strip()
    if load == "not-found" and p.get("ActiveState") in ("inactive", "failed") and not drop:
        return False, None
    if load != "loaded":
        return True, "LoadState=%s" % (load or "unknown")
    if frag != str(SYS_UNIT):
        return True, "loaded from %s" % (frag or "no unit file (transient)")
    if drop:
        return True, "drop-ins: %s" % drop[:200]
    if p.get("NeedDaemonReload") == "yes":
        return True, "%s changed on disk since systemd loaded it" % SYS_UNIT
    return True, None


def tun_unit_check(uid):
    """(loaded, why_foreign) for TUN_SERVICE as seen by `uid`. Every start and
    stop of the root unit, by root or by the user, goes through this. Ours
    means: what systemd loaded is SYS_UNIT itself with no drop-ins
    (_loaded_tun_unit), and SYS_UNIT is what tun-install wrote for this uid
    (the record, or byte-identical), not another user's setup."""
    loaded, why = _loaded_tun_unit()
    if why or not (loaded or os.path.lexists(SYS_UNIT)):
        return loaded, why
    rec = _tun_record()
    if rec and rec["uid"] != uid:
        return loaded, "set up for another user (%s)" % str(rec.get("user") or rec["uid"])[:32]
    ip = tool("ip")
    text = tun_unit_text(uid, ip, tool("udevadm"), tool("resolvectl")) if ip else None
    if not os.path.lexists(SYS_UNIT) or not _ours(SYS_UNIT, text, rec, uid):
        return loaded, "%s was not written by omarchy-xray for uid %d, or changed since" % (SYS_UNIT, uid)
    return loaded, None


def cmd_tun_unit(verb):
    """[user unit] Start or stop the root unit through polkit, only when it
    is ours (tun_unit_check); a foreign one is refused, never touched."""
    if verb not in ("start", "stop"):
        die("usage: omarchy-xray tun-unit <start|stop>")
    loaded, why = tun_unit_check(os.getuid())
    if why:
        die("refusing to %s %s: %s — review it, then run omarchy-xray tun-setup" % (verb, TUN_SERVICE, why))
    if verb == "stop" and not loaded:
        out({"ok": True, "stopped": False})
        return
    if verb == "start" and not tun_installed():
        die(TUN_SETUP_HINT)
    r = sctl(verb, TUN_SERVICE, timeout=60)
    if r.returncode != 0:
        die("%s %s failed: %s" % (verb, TUN_SERVICE, _last_lines(r.stderr) or "denied"))
    out({"ok": True})


def cmd_tun_install():
    """[root] Write the TUN system unit, the polkit rule and (with networkd)
    an Unmanaged drop-in, plus a record of them. Inputs: the invoking uid only;
    no user files read. Refuses to replace anything it did not write."""
    if os.geteuid() != ROOT:
        die("tun-install must run as root — use: omarchy-xray tun-setup")
    pw = _invoking_user()
    managed = dict(_managed(pw))
    if managed[SYS_UNIT] is None:
        die("ip (iproute2) not found")
    networkd = sh(SYSTEMCTL, "is-active", "systemd-networkd").stdout.strip() == "active"
    want = [SYS_UNIT, POLKIT_RULE] + ([NETWORKD_FILE] if networkd else [])
    rec, foreign = _foreign(pw, want)
    if foreign:
        die("refusing to replace %s: not written by omarchy-xray for %s, or changed since — "
            "review and remove it yourself, then run tun-setup again; nothing was changed"
            % (", ".join(foreign), pw.pw_name))
    loaded, why = tun_unit_check(pw.pw_uid)
    if why:
        die("refusing: the loaded %s is not the one omarchy-xray writes (%s) — "
            "review it yourself, then run tun-setup again; nothing was changed" % (TUN_SERVICE, why))
    if loaded:
        sh(SYSTEMCTL, "stop", TUN_SERVICE)   # our previous unit, from SYS_UNIT
    files = {k: v for k, v in rec.get("files", {}).items() if pathlib.Path(k).exists()}
    files.update({str(p): _sha(managed[p]) for p in want})
    record = json.dumps({"uid": pw.pw_uid, "user": pw.pw_name, "files": files}, indent=1) + "\n"
    _root_write_all([(p, managed[p]) for p in want] + [(TUN_RECORD, record)])
    if networkd:
        nc = tool("networkctl")
        if nc:
            sh(nc, "reload")
    sh(SYSTEMCTL, "daemon-reload")
    out({"ok": True, "user": pw.pw_name, "unit": str(SYS_UNIT), "polkit": str(POLKIT_RULE),
         "networkd": networkd})


def cmd_tun_uninstall():
    """[root] Remove what tun-install wrote for the invoking user. A foreign or
    changed unit stops everything; other foreign or changed files are kept."""
    if os.geteuid() != ROOT:
        die("tun-uninstall must run as root — use: omarchy-xray tun-remove")
    pw = _invoking_user()
    paths = (SYS_UNIT, POLKIT_RULE, NETWORKD_FILE)
    _, foreign = _foreign(pw, paths)
    if str(SYS_UNIT) in foreign:
        die("refusing: %s was not written by omarchy-xray for %s, or changed since — nothing was removed"
            % (SYS_UNIT, pw.pw_name))
    loaded, why = tun_unit_check(pw.pw_uid)
    if why:
        die("refusing: the loaded %s is not the one omarchy-xray writes (%s) — nothing was removed"
            % (TUN_SERVICE, why))
    if loaded:
        sh(SYSTEMCTL, "stop", TUN_SERVICE)
    removed, kept = [], []
    for p in paths:
        if str(p) in foreign:
            kept.append(str(p))
        elif os.path.lexists(p):
            p.unlink()
            removed.append(str(p))
    try:
        TUN_RECORD.unlink()                    # whatever was kept is not ours any more
    except FileNotFoundError:
        pass
    sh(SYSTEMCTL, "daemon-reload")
    if str(NETWORKD_FILE) in removed and tool("networkctl"):
        sh(tool("networkctl"), "reload")
    out({"ok": True, "removed": removed, "kept": kept})


def _escalate(verb):
    """One privileged invocation of this script. pkexec (polkit prompt) from
    the widget; sudo when run from a terminal."""
    if sys.stdin.isatty() and tool("sudo"):
        r = subprocess.run([tool("sudo"), SELF, verb], env=child_env())
        return r.returncode, "", ""
    pk = tool("pkexec")
    if not pk:
        die("pkexec not found — run manually: sudo %s %s" % (SELF, verb))
    r = sh(pk, SELF, verb, timeout=600)
    return r.returncode, r.stdout, r.stderr


def _escalated_error(rc, so, se):
    """Why the privileged half failed: its JSON error, else stderr's tail."""
    try:
        msg = json.loads(so.strip().splitlines()[-1]).get("error", "")
    except Exception:
        msg = _last_lines(se, n=2)
    return msg or {127: "not authorized, or no password prompt available"}.get(rc, "exit %d" % rc)


def cmd_tun_setup():
    if not T2S:
        die(T2S_HINT)
    rc, so, se = _escalate("tun-install")
    if rc == 126:
        die("TUN setup cancelled: nothing was changed")
    if rc != 0:
        die("TUN setup failed (%s). Run it in a terminal instead: sudo %s tun-install"
            % (_escalated_error(rc, so, se), SELF))
    write_user_units()
    out({"ok": True, "tunInstalled": tun_installed()})


def _tun_remove(st):
    if tun_active():
        stop_service()
    rc, so, se = _escalate("tun-uninstall")
    if rc != 0:
        die("TUN removal failed (%s) — run manually: sudo %s tun-uninstall"
            % (_escalated_error(rc, so, se), SELF))
    uctl("disable", T2S_SERVICE)
    if st["mode"] == "tun":
        st["mode"] = "proxy"
        save_state(st)


def cmd_tun_remove():
    _tun_remove(load_state())
    out({"ok": True, "tunInstalled": tun_installed()})


def cmd_cleanup():
    """Undo everything this plugin set up outside its folder, except the
    subscriptions in ~/.config/omarchy-xray. Run before `omarchy plugin remove`."""
    st = load_state()
    stop_service()
    apply_system_proxy(st, False)
    if SYS_UNIT.is_file():
        _tun_remove(st)                    # one polkit/sudo prompt
    removed = []
    for path in (UNIT, T2S_UNIT, UNIT_DIR / "omarchy-xray-tun-login.service"):
        if path.exists():
            uctl("disable", path.name)
            path.unlink()
            removed.append(str(path))
    uctl("daemon-reload")
    out({"ok": True, "removed": removed, "kept": str(CFG)})


def cmd_proxy_sync():
    """[user unit] Proxy settings for the mode in state.json (cleared in TUN)."""
    apply_system_proxy(load_state(), True)
    out({"ok": True})


def cmd_tun_run():
    """[user unit] tun2socks on xray0 -> xray's socks port. Meanwhile follow
    the default route (Wi-Fi <-> Ethernet): xray's outbounds are bound to one
    interface, so a new one means a new config and an xray restart."""
    if not T2S:
        die(T2S_HINT)
    t2s = subprocess.Popen([T2S, "-device", "tun://" + TUN_NAME, "-proxy",
                            "socks5://127.0.0.1:%d" % SOCKS, "-loglevel", "warn"],
                           env=child_env())
    while True:
        try:
            sys.exit(t2s.wait(timeout=5) or 1)     # it never exits on its own
        except subprocess.TimeoutExpired:
            _rebind()      # ponytail: 5 s route poll; `ip monitor route` if lag matters


def _rebind():
    dev = default_dev()
    if not dev or dev == bound_iface():
        return False
    if not _lock():
        return False                 # someone is changing things; next poll retries
    try:
        st = load_state()
        if st["mode"] != "tun" or not st["nodes"]:
            return False
        write_config(st)
        uctl("restart", SERVICE)
        return True
    finally:
        os.close(_LOCK_FD)               # releases the lock


# --- main --------------------------------------------------------------------

ROOT_COMMANDS = {"tun-install", "tun-uninstall"}
LOCKED_COMMANDS = {"import", "subremove", "update", "select", "mode", "routing", "adblock", "fragment", "rule", "dns", "fav", "set", "settings", "chain", "scan", "geo", "speed",
                   "on", "restart", "tun-remove", "cleanup"}
_LOCK_FD = None


def _lock():
    """One state-changing command at a time (an update saving its node list
    must not undo a node switch made meanwhile). `off` never takes it."""
    global _LOCK_FD
    import fcntl
    _cfg_dir()
    fd = os.open(str(CFG / ".lock"), os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        os.close(fd)
        return False
    _LOCK_FD = fd
    return True


def main():
    args = sys.argv[1:]
    if not args:
        die("usage: omarchy-xray <import|subremove|update|select|mode|routing|adblock|fragment|rule|dns|on|off|"
            "restart|test|status|logs|doctor|tun-setup|tun-remove|cleanup> [arg]")
    cmd, rest = args[0], args[1:]
    arg = rest[0] if rest else ""
    if os.geteuid() == 0 and cmd not in ROOT_COMMANDS:
        die("refusing to run as root — run omarchy-xray as your user")
    if cmd in LOCKED_COMMANDS and not _lock():
        die("another change is still running (update, mode switch…) — try again in a moment")
    table = {
        "import": lambda: cmd_import(arg),
        "subremove": lambda: cmd_subremove(arg),
        "update": lambda: cmd_update(arg),
        "select": lambda: cmd_select(arg),
        "mode": lambda: cmd_mode(arg),
        "routing": lambda: cmd_routing(arg),
        "adblock": lambda: cmd_adblock(arg),
        "fragment": lambda: cmd_fragment(rest[:4]),
        "rule": lambda: cmd_rule(rest[:3]),
        "fav": lambda: cmd_fav(arg),
        "set": lambda: cmd_set(arg, rest[1] if len(rest) > 1 else ""),
        "whoami": cmd_whoami,
        "scan": cmd_scan,
        "speed": lambda: cmd_speed(arg),
        "geo": lambda: cmd_geo(arg),
        "chain": lambda: cmd_chain(arg),
        "share": lambda: cmd_share(arg, rest[1] if len(rest) > 1 else ""),
        "settings": lambda: cmd_settings(arg),
        "dns": lambda: cmd_dns(arg, rest[1] if len(rest) > 1 else ""),
        "on": cmd_on,
        "off": cmd_off,
        "restart": cmd_restart,
        "test": lambda: cmd_test([a for a in rest if a][:MAX_TEST_NODES]),
        "status": cmd_status,
        "logs": lambda: cmd_logs(arg or "40"),
        "doctor": cmd_doctor,
        "tun-run": cmd_tun_run,
        "proxy-sync": cmd_proxy_sync,
        "tun-unit": lambda: cmd_tun_unit(arg),
        "cleanup": cmd_cleanup,
        "tun-setup": cmd_tun_setup,
        "tun-remove": cmd_tun_remove,
        "tun-install": cmd_tun_install,
        "tun-uninstall": cmd_tun_uninstall,
    }
    fn = table.get(cmd)
    if fn is None:
        die("unknown command: " + cmd[:32])
    fn()


if __name__ == "__main__":
    main()
